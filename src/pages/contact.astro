---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout title="Contact Us — When to Visit Japan" description="Get in touch with When to Visit Japan. Report errors, share your travel stories, suggest features, or reach out for press & media inquiries.">
  <section class="min-h-[100dvh]">
    <Nav />
    <div class="max-w-2xl mx-auto px-4 py-6">
      <p class="text-sm font-medium tracking-wide text-accent-600 uppercase mb-4">Contact</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tighter text-zinc-900 mb-4 leading-none">Get in Touch</h1>
      <p class="text-lg text-zinc-500 leading-relaxed mb-12">We read every message. Corrections, suggestions, and travel stories are all welcome.</p>

      <h2 class="text-2xl font-bold text-zinc-900 mb-6">Send Us a Message</h2>
      <div class="space-y-8">
        <div class="bg-white border border-zinc-200 rounded-2xl p-8">
          <h3 class="text-lg font-bold text-zinc-900 mb-2">Email Us</h3>
          <p class="text-sm text-zinc-600 mb-4">The best way to reach us. We typically respond within 24 hours.</p>
          <a href="mailto:hello@when-to-visit-japan.com" class="inline-flex items-center gap-2 px-6 py-3 bg-accent-600 hover:bg-accent-700 text-white font-semibold rounded-full transition-colors text-sm">
            hello@when-to-visit-japan.com
          </a>
        </div>

        <h2 class="text-2xl font-bold text-zinc-900 mb-4">Other Ways to Reach Us</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-white border border-zinc-200 rounded-xl p-6">
            <p class="text-sm font-bold text-zinc-800 mb-1">Report an Error</p>
            <p class="text-xs text-zinc-500 leading-relaxed">Found a wrong date, outdated price, or broken link? Let us know — we'll fix it promptly.</p>
          </div>
          <div class="bg-white border border-zinc-200 rounded-xl p-6">
            <p class="text-sm font-bold text-zinc-800 mb-1">Share Your Story</p>
            <p class="text-xs text-zinc-500 leading-relaxed">Traveled to Japan recently? We'd love to feature your experience in our traveler stories section.</p>
          </div>
          <div class="bg-white border border-zinc-200 rounded-xl p-6">
            <p class="text-sm font-bold text-zinc-800 mb-1">Suggest a Feature</p>
            <p class="text-xs text-zinc-500 leading-relaxed">Have an idea for a new tool or section? We're always improving.</p>
          </div>
          <div class="bg-white border border-zinc-200 rounded-xl p-6">
            <p class="text-sm font-bold text-zinc-800 mb-1">Press & Media</p>
            <p class="text-xs text-zinc-500 leading-relaxed">For interview requests, data licensing, or partnership inquiries.</p>
          </div>
        </div>
      </div>
    </div>
  </section>
  <Footer />
</BaseLayout>