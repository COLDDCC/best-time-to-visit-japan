---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found | When to Visit Japan" description="Sorry, the page you are looking for does not exist. Return to our homepage to plan your perfect Japan trip with expert guides and tools.">
  <section class="min-h-[100dvh] flex items-center justify-center bg-zinc-50">
    <div class="text-center px-4 max-w-md">
      <p class="text-8xl font-bold text-zinc-200 mb-4">404</p>
      <h1 class="text-2xl font-bold text-zinc-900 mb-3">This page does not exist</h1>
      <p class="text-zinc-500 leading-relaxed mb-8">Maybe you were looking for the best time to visit Japan? That page is right here.</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a href="/" class="inline-flex items-center justify-center gap-2 px-6 py-3 bg-accent-600 text-white font-semibold rounded-full hover:bg-accent-700 transition-colors">
          Go to Homepage
        </a>
        <a href="/when-to-go" class="inline-flex items-center justify-center gap-2 px-6 py-3 border border-zinc-300 text-zinc-700 font-medium rounded-full hover:border-accent-400 hover:text-accent-600 transition-colors">
          Take the Quiz
        </a>
      </div>
    </div>
  </section>
</BaseLayout>