---
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import Callout from "../components/Callout.astro";
import CostChart from "../components/islands/CostChart";
import HotelComparison from "../components/islands/HotelComparison";

const costComparison = [
  { category: "Hostel / Capsule / Guesthouse", low: 25, mid: 45, high: 80, note: "per night" },
  { category: "Business Hotel (APA etc.)", low: 50, mid: 80, high: 130, note: "per night" },
  { category: "3-Star Hotel", low: 70, mid: 110, high: 180, note: "per night" },
  { category: "4-5 Star / Ryokan (with meals)", low: 150, mid: 300, high: 800, note: "per night" },
  { category: "Convenience store meal (onigiri, bento)", low: 4, mid: 8, high: 15, note: "per person" },
  { category: "Ramen / Fast-casual meal", low: 8, mid: 12, high: 20, note: "per person" },
  { category: "Mid-range izakaya / restaurant", low: 20, mid: 40, high: 80, note: "per person" },
  { category: "Subway / Train (single ride)", low: 1.5, mid: 2.5, high: 5, note: "per ride" },
  { category: "Shinkansen (Tokyo to Kyoto)", low: 90, mid: 115, high: 160, note: "2nd class" },
  { category: "Museum / Temple entrance", low: 0, mid: 8, high: 25, note: "per person" },
];

const itineraries = [
  {
    name: "Budget Backpacker (10 days)",
    total: "$1,680",
    perDay: "$168",
    breakdown: [
      { item: "Flights (US-Tokyo round-trip, June/Sept)", cost: "$950" },
      { item: "Capsule/hostel stays (9 nights at $40/night)", cost: "$360" },
      { item: "Convenience stores + ramen + cheap eats", cost: "$180" },
      { item: "JR pass (7-day regional) + local transit", cost: "$180" },
      { item: "Attractions (temples, shrines, museums)", cost: "$60" },
      { item: "Sim card + incidentals", cost: "$50" },
    ],
  },
  {
    name: "Mid-Range Comfort (10 days)",
    total: "$3,470",
    perDay: "$347",
    breakdown: [
      { item: "Flights (US-Tokyo round-trip, shoulder season)", cost: "$1,200" },
      { item: "3-4 star hotels (9 nights at $140/night avg)", cost: "$1,260" },
      { item: "Mix of ramen, izakaya & nice restaurants", cost: "$450" },
      { item: "7-day JR pass + local transport + 1 shinkansen", cost: "$300" },
      { item: "Attractions + 2 day tours (Fuji, Nara)", cost: "$180" },
      { item: "Sim card + travel insurance + incidentals", cost: "$80" },
    ],
  },
  {
    name: "Premium Experience (10 days)",
    total: "$6,900",
    perDay: "$690",
    breakdown: [
      { item: "Flights (US-Tokyo round-trip, premium economy)", cost: "$2,000" },
      { item: "Luxury hotels + 2 ryokan stays with kaiseki", cost: "$3,200" },
      { item: "Fine dining + best sushi & kaiseki reservations", cost: "$800" },
      { item: "Private car + driver + Green Car shinkansen", cost: "$500" },
      { item: "VIP tours, private guides, tea ceremony", cost: "$300" },
      { item: "Premium sim, comprehensive insurance, incidentals", cost: "$100" },
    ],
  },
];

const cityCosts = [
  { city: "Tokyo", tier: "Metropolis", hotel: "$80-400", food: "$8-100", transport: "$2-5", vibe: "The full range. World-class food and transport, hotel prices surge near Shibuya & Shinjuku." },
  { city: "Osaka", tier: "Metropolis", hotel: "$60-300", food: "$6-80", transport: "$2-5", vibe: "Japan's kitchen - cheaper dining than Tokyo. Great base for day trips." },
  { city: "Kyoto", tier: "Heritage", hotel: "$80-500", food: "$8-120", transport: "$2-4", vibe: "Premium temple-side stays. Book months ahead during sakura and koyo." },
  { city: "Sapporo", tier: "Regional Hub", hotel: "$50-250", food: "$6-60", transport: "$2-4", vibe: "Affordable by Japanese standards. Best value in summer; ski-season prices jump." },
  { city: "Fukuoka", tier: "Regional Hub", hotel: "$45-200", food: "$5-50", transport: "$2-3", vibe: "Great value with superb ramen and yatai street stalls. Near Korea and China." },
  { city: "Hiroshima", tier: "Regional", hotel: "$40-150", food: "$5-60", transport: "$2-3", vibe: "Cheaper than Kansai with easy access to Miyajima and Shimanami Kaido." },
  { city: "Naha (Okinawa)", tier: "Tropical", hotel: "$50-300", food: "$5-50", transport: "$2-4", vibe: "Resort pricing near the beach, town pricing in the city. Best Dec-Apr." },
  { city: "Niseko / Alps", tier: "Resort", hotel: "$100-800", food: "$10-150", transport: "$3-10", vibe: "Ski-resort premium. Book far ahead in winter - prices triple at peak." },
];

const moneyTips = [
  { tip: "Fly into Tokyo and out of Osaka (or vice versa) to save money and avoid backtracking." },
  { tip: "Travel in June or September: flights and hotels drop 20-30% versus sakura and koyo peaks." },
  { tip: "Use a 7-day JR Pass for long-haul shinkansen trips; ride local metros for anything under 30 minutes." },
  { tip: "Eat where locals eat: ramen counters, curry shops, and conveyor sushi cost $8-15 and are outstanding." },
  { tip: "Book hotels via Japanese platforms (Rakuten Travel, Japanican) for lower prices than Booking.com." },
  { tip: "Avoid Golden Week (Apr 29-May 5), Obon (Aug 11-16), and New Year. Prices triple and rooms vanish." },
  { tip: "Convenience stores (7-Eleven, FamilyMart) are your budget hero: great breakfasts for under $5." },
  { tip: "Carry cash - many small shops and temple stalls in Japan are cash-only." },
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "How much does a trip to Japan cost?", "acceptedAnswer": { "@type": "Answer", "text": "A 10-day trip to Japan costs $1,680 on a budget, $3,470 mid-range, or $6,900 premium per person including flights from the US." } },
    { "@type": "Question", "name": "What is the cheapest month to fly to Japan?", "acceptedAnswer": { "@type": "Answer", "text": "June and September are typically the cheapest months to fly to Japan, with fares often 20-30% below sakura and autumn peaks." } },
  ],
});
---

<BaseLayout title="Japan Travel Cost Guide: Flights, Hotels & Budgets" description="Complete cost breakdown for traveling in Japan: flight prices by month, hotel costs by season & city, three sample itineraries at every budget level.">
  <script type="application/ld+json" set:html={schema} />
  <section class="min-h-[100dvh]">
    <Nav />
    <div class="max-w-7xl mx-auto px-4 py-6">
      <p class="text-sm font-medium tracking-wide text-accent-600 uppercase mb-4">Travel Cost</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tighter text-zinc-900 mb-4 leading-none">Japan Travel Cost Guide</h1>
      <p class="text-lg text-zinc-500 max-w-2xl leading-relaxed mb-16">Everything you will actually spend, broken down by season, city, and travel style.</p>

      <PageHero image="/images/region-tokyo.webp" alt="Tokyo skyline at dusk with the lit Tokyo Tower" overlay="Travel Cost" title="A 10-day trip costs $1,680 to $6,900 depending on your style" />

      <!-- Three budgets at a glance -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-16">
        {itineraries.map((iti, i) => (
          <div class={`rounded-2xl px-7 py-8 ${i === 1 ? "bg-zinc-900 text-white relative" : "bg-white border border-zinc-200"}`}>
            {i === 1 && (
              <span class="absolute top-4 right-4 text-[10px] font-semibold tracking-widest uppercase px-2 py-0.5 rounded-full bg-accent-600 text-white">Best Value</span>
            )}
            <p class={`text-[11px] font-semibold tracking-[0.2em] uppercase ${i === 1 ? "text-zinc-400" : "text-zinc-400"}`}>{iti.name}</p>
            <p class={`mt-3 text-4xl font-serif italic leading-none ${i === 1 ? "text-white" : "text-zinc-900"}`}>{iti.total}</p>
            <p class={`mt-2 text-sm ${i === 1 ? "text-zinc-400" : "text-zinc-500"}`}>{iti.perDay} / person &middot; 10 days, flights in</p>
          </div>
        ))}
      </div>

      <!-- Flights & Hotels Charts -->
      <div class="mb-16">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
          <div>
            <p class="text-xs font-semibold tracking-[0.2em] uppercase text-accent-600 mb-3">01 &middot; Flights &amp; Hotels</p>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-zinc-900 leading-none">Prices that follow <em>the seasons</em></h2>
          </div>
          <p class="md:w-80 text-zinc-500 leading-relaxed">Price indices from median <a href="https://www.google.com/travel/flights" target="_blank" rel="noopener" class="text-accent-600 hover:text-accent-700 underline">Google Flights</a> and hotel booking data, sampled monthly. Actual prices vary by departure city and booking date.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <CostChart />
          <HotelComparison />
        </div>
      </div>

      <!-- Cost Comparison Table -->
      <div class="mb-16">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
          <div>
            <p class="text-xs font-semibold tracking-[0.2em] uppercase text-accent-600 mb-3">02 &middot; Everyday Costs</p>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-zinc-900 leading-none">What the little things <em>add up to</em></h2>
          </div>
          <p class="md:w-80 text-zinc-500 leading-relaxed">Prices in USD. Low = budget option, Mid = comfortable, High = premium.</p>
        </div>
        <div class="overflow-x-auto rounded-xl border border-zinc-200">
          <table class="w-full text-base">
            <thead>
              <tr class="bg-zinc-50 border-b border-zinc-200">
                <th class="text-left p-4 font-semibold text-zinc-600">Category</th>
                <th class="text-center p-4 font-semibold text-emerald-600">Budget</th>
                <th class="text-center p-4 font-semibold text-amber-600">Mid</th>
                <th class="text-center p-4 font-semibold text-red-500">Premium</th>
                <th class="text-left p-4 font-semibold text-zinc-400 text-sm">Unit</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-100">
              {costComparison.map((row) => (
                <tr class="hover:bg-zinc-50/50">
                  <td class="p-4 font-medium text-zinc-700">{row.category}</td>
                  <td class="p-4 text-center text-emerald-700 font-semibold">${row.low}</td>
                  <td class="p-4 text-center text-amber-700 font-semibold">${row.mid}</td>
                  <td class="p-4 text-center text-red-600 font-semibold">${row.high}</td>
                  <td class="p-4 text-zinc-400 text-sm">{row.note}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Sample Itineraries -->
      <div class="mb-16">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">
          <div>
            <p class="text-xs font-semibold tracking-[0.2em] uppercase text-accent-600 mb-3">03 &middot; Real Itineraries</p>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-zinc-900 leading-none">From backpacker <em>to blowout</em></h2>
          </div>
          <p class="md:w-80 text-zinc-500 leading-relaxed">Three 10-day plans including round-trip flights from the US &mdash; pick one, then adjust to taste.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {itineraries.map((iti, i) => (
            <div class={`relative bg-white border ${i === 1 ? "border-accent-300 ring-1 ring-accent-300 shadow-md" : "border-zinc-200"} rounded-2xl p-6`}>
              {i === 1 && (
                <span class="absolute -top-0 -right-0 rounded-tr-2xl rounded-bl-2xl bg-accent-600 text-white text-[10px] font-semibold tracking-widest uppercase px-3 py-1">Recommended</span>
              )}
              <p class="text-base font-bold text-zinc-900 mb-1">{iti.name}</p>
              <div class="flex items-baseline gap-2 mb-4">
                <span class={`text-3xl font-bold ${i === 1 ? "text-accent-600" : "text-zinc-900"}`}>{iti.total}</span>
                <span class="text-sm text-zinc-400">{iti.perDay}/day</span>
              </div>
              <div class="space-y-2.5">
                {iti.breakdown.map((b) => (
                  <div class="flex items-center justify-between text-base">
                    <span class="text-zinc-600">{b.item}</span>
                    <span class="font-semibold text-zinc-800">{b.cost}</span>
                  </div>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Cost by City -->
      <div class="mb-16">
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">
          <div>
            <p class="text-xs font-semibold tracking-[0.2em] uppercase text-accent-600 mb-3">04 &middot; Cost by City</p>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-zinc-900 leading-none">How much <em>each city costs</em></h2>
          </div>
          <p class="md:w-80 text-zinc-500 leading-relaxed">Japan spans world-class metros and affordable regional hubs &mdash; here is the spread.</p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
          {cityCosts.map((c) => (
            <div class="bg-white border border-zinc-200 rounded-xl p-5">
              <div class="flex items-center justify-between mb-3">
                <p class="text-base font-bold text-zinc-800">{c.city}</p>
                <span class="text-[10px] font-semibold tracking-widest uppercase px-2 py-0.5 rounded-full bg-zinc-100 text-zinc-500">{c.tier}</span>
              </div>
              <div class="space-y-2.5 text-base">
                <div class="flex justify-between"><span class="text-zinc-400">Hotel</span><span class="font-medium text-zinc-700">{c.hotel}</span></div>
                <div class="flex justify-between"><span class="text-zinc-400">Meal</span><span class="font-medium text-zinc-700">{c.food}</span></div>
                <div class="flex justify-between"><span class="text-zinc-400">Transport</span><span class="font-medium text-zinc-700">{c.transport}</span></div>
              </div>
              <p class="text-sm text-zinc-600 mt-3 leading-relaxed border-t border-zinc-100 pt-3">{c.vibe}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Money-Saving Tips -->
      <Callout eyebrow="05 &middot; Spend Less" tone="green" class="mt-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {moneyTips.map((t, i) => (
            <div class="flex items-start gap-3 bg-white rounded-lg p-4 border border-zinc-100">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-accent-100 text-accent-600 text-xs font-bold flex items-center justify-center mt-0.5">{i + 1}</span>
              <p class="text-base text-zinc-700 leading-relaxed">{t.tip}</p>
            </div>
          ))}
        </div>
      </Callout>
    </div>
  </section>
  <Footer />
</BaseLayout>