---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Callout from "../../components/Callout.astro";
import Icon from "../../components/Icon.astro";
import { spotGuides } from "../../data/spots.ts";
import { regionGuides } from "../../data/regions.ts";

export function getStaticPaths() {
  return spotGuides.map((s) => ({
    params: { slug: s.slug },
    props: { spot: s },
  }));
}

const { spot } = Astro.props;
const canonical = `https://best-time-japan.com/spots/${spot.slug}`;
const logoUrl = spot.logo ? `https://best-time-japan.com${spot.logo}` : undefined;
const parentRegion = regionGuides.find((r) => r.slug === spot.region);
const ratingStars = spot.rating
  ? "★".repeat(Math.round(spot.rating.score)) + "☆".repeat(5 - Math.round(spot.rating.score))
  : "";
const isAttraction = spot.kind === "attraction";

const spotSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": spot.kind === "attraction" ? "TouristAttraction" : "CafeOrCoffeeShop",
  "name": spot.name,
  "description": spot.meta,
  "address": spot.address,
  "telephone": spot.phone.split(" ")[0],
  "priceRange": spot.priceRange,
  "url": canonical,
  ...(spot.image ? { "image": spot.image } : {}),
  ...(logoUrl ? { "logo": logoUrl } : {}),
  ...(spot.rating ? { "aggregateRating": { "@type": "AggregateRating", "ratingValue": spot.rating.score, "reviewCount": spot.rating.count } } : {}),
  ...(spot.socialLinks && spot.socialLinks.length > 0
    ? { "sameAs": spot.socialLinks.map((s) => s.url) }
    : {}),
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": spot.faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
});
---

<BaseLayout title={`${spot.name} — ${spot.tagline}`} description={spot.meta} ogImage={spot.image}>
  <script type="application/ld+json" set:html={spotSchema} />
  <script type="application/ld+json" set:html={faqSchema} />

  <section class="min-h-[100dvh]">
    <Nav />
    <div class="max-w-4xl mx-auto px-4 py-8">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-accent-600 mb-4">Spot Guide {parentRegion && `· ${parentRegion.shortName}`}</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tighter text-zinc-900 mb-4 leading-none">{spot.name}</h1>
      <p class="text-lg text-zinc-500 leading-relaxed mb-2">{spot.tagline} — {spot.city}</p>
      <p class="text-sm font-medium text-blue-700 mb-10">Best time to go: {spot.bestTime}</p>

      <!-- Hero + Quick Facts -->
      <div class="flex flex-col md:flex-row gap-6 mb-12">
        <div class="order-2 md:order-1 flex-1 bg-gradient-to-br from-amber-50 via-white to-blue-50 border border-zinc-200 rounded-2xl p-6 sm:p-8">
          {spot.rating && (
            <a href={spot.rating.url} target="_blank" rel="noopener" class="flex items-center gap-3 no-underline group mb-6">
              <span class="text-5xl font-bold text-zinc-900 tabular-nums group-hover:text-amber-700 transition-colors">{spot.rating.score.toFixed(1)}</span>
              <span class="flex flex-col">
                <span class="text-amber-500 text-2xl leading-none">{ratingStars}</span>
                <span class="text-sm text-zinc-500 mt-1">{spot.rating.count} ratings on Google, as of {spot.rating.asOf}</span>
              </span>
            </a>
          )}
          <div class="flex flex-wrap items-center gap-3 mb-6">
            {spot.reviewLinks.find((r) => r.label === "Google Maps") && (
              <a href={spot.reviewLinks.find((r) => r.label === "Google Maps")!.url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-4 bg-blue-50 border border-blue-200 rounded-full text-lg font-semibold text-blue-800 no-underline hover:bg-blue-100 transition-colors">
                📍 Directions ↗
              </a>
            )}
            {spot.reviewLinks.find((r) => r.label === "Official site") && (
              <a href={spot.reviewLinks.find((r) => r.label === "Official site")!.url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-4 bg-white border border-zinc-200 rounded-full text-lg font-semibold text-zinc-700 no-underline hover:bg-zinc-100 transition-colors">
                🌐 Official Site ↗
              </a>
            )}
            {spot.socialLinks && spot.socialLinks.map((s) => (
              <a href={s.url} target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-6 py-4 bg-white border border-zinc-200 rounded-full text-lg font-semibold text-zinc-700 no-underline hover:bg-zinc-100 transition-colors">
                {s.emoji} {s.label} ↗
              </a>
            ))}
          </div>
        </div>
        {spot.image ? (
          <img src={spot.image} alt={spot.imageAlt} loading="lazy" decoding="async" class="order-1 md:order-2 w-full md:w-64 lg:w-72 flex-shrink-0 h-auto rounded-2xl shadow-sm border border-zinc-100 object-cover" />
        ) : (
          <div class="order-1 md:order-2 w-full md:w-64 lg:w-72 flex-shrink-0 h-48 md:h-auto rounded-2xl border border-dashed border-zinc-300 bg-zinc-50 flex items-center justify-center">
            <p class="text-xs text-zinc-400 text-center px-4">Photo coming soon</p>
          </div>
        )}
      </div>

      <div class="bg-white border-2 border-zinc-200 rounded-2xl p-6 sm:p-8 mb-12 shadow-sm">
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <p class="text-xs font-semibold tracking-wide text-zinc-400 uppercase mb-1">Hours</p>
            <p class="text-base font-semibold text-zinc-900 whitespace-pre-line">{spot.hours}</p>
          </div>
          <div>
            <p class="text-xs font-semibold tracking-wide text-zinc-400 uppercase mb-1">{isAttraction ? "Visitor Info" : "Reservations"}</p>
            <p class="text-base font-semibold text-zinc-900 whitespace-pre-line">{spot.phone}</p>
          </div>
        </div>

        {spot.highlightTags && spot.highlightTags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6 pt-6 border-t border-zinc-100">
            {spot.highlightTags.map((t) => (
              <span class="px-3 py-1.5 bg-zinc-50 border border-zinc-200 rounded-full text-sm text-zinc-600">{t}</span>
            ))}
          </div>
        )}
      </div>

      <!-- Intro -->
      {spot.intro.map((p) => (
        <p class="text-zinc-600 leading-relaxed mb-6 text-base md:text-lg">{p}</p>
      ))}

      <!-- Exterior gallery -->
      {spot.exteriorImages && spot.exteriorImages.length > 0 && (
        <>
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">Exterior</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12" aria-label="Exterior photos">
            {spot.exteriorImages.map((g) => (
              <img src={g.src} alt={g.alt} loading="lazy" decoding="async" class="w-full aspect-[4/3] object-cover rounded-xl border border-zinc-100" />
            ))}
          </div>
        </>
      )}

      <!-- Interior gallery -->
      {spot.interiorImages && spot.interiorImages.length > 0 && (
        <>
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">Interior</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-12" aria-label="Interior photos">
            {spot.interiorImages.map((g) => (
              <img src={g.src} alt={g.alt} loading="lazy" decoding="async" class="w-full aspect-[4/3] object-cover rounded-xl border border-zinc-100" />
            ))}
          </div>
        </>
      )}

      <!-- Highlights -->
      <h2 class="text-2xl font-bold text-zinc-900 mt-12 mb-6">Highlights</h2>
      <div class="space-y-6 mb-12">
        {spot.highlights.map((h) => (
          <div class="border-t border-zinc-200 pt-6 first:border-t-0 first:pt-0">
            <p class="text-base font-bold text-zinc-900 mb-1.5">{h.title}</p>
            <p class="text-sm text-zinc-600 leading-relaxed">{h.body}</p>
          </div>
        ))}
      </div>

      <!-- Menu -->
      <h2 class="text-2xl font-bold text-zinc-900 mb-2">{isAttraction ? "Getting Around & Costs" : "What to Order"}</h2>
      <p class="text-sm text-zinc-500 mb-6">Prices in Japanese yen (JPY).</p>
      <div class="mb-12">
        {spot.menu.map((m) => (
          <div class="flex items-baseline justify-between gap-4 border-t border-zinc-200 py-4 first:border-t-0">
            <div>
              <p class="text-sm font-bold text-zinc-900">{m.name}</p>
              <p class="text-xs text-zinc-500 mt-0.5">{m.note}</p>
            </div>
            <p class="text-sm font-semibold text-accent-700 flex-shrink-0 tabular-nums">{m.price}</p>
          </div>
        ))}
      </div>

      <!-- Seasonal picks -->
      {spot.seasonalPicks && spot.seasonalPicks.length > 0 && (
        <div class="bg-gradient-to-br from-blue-50 to-amber-50 rounded-2xl p-6 sm:p-8 mb-12">
          <h2 class="text-2xl font-bold text-zinc-900 mb-6">Seasonal Picks</h2>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {spot.seasonalPicks.map((s) => (
              <div class="bg-white border border-zinc-200 rounded-xl overflow-hidden">
                {s.image && (
                  <img src={s.image} alt={s.imageAlt || s.title} loading="lazy" decoding="async" class="w-full aspect-[4/3] object-cover" />
                )}
                <div class="p-5">
                  <p class="text-sm font-bold text-zinc-900 mb-1.5">{s.title}</p>
                  <p class="text-xs text-zinc-500 leading-relaxed">{s.note}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- Visit info -->
      <div class="bg-zinc-50 rounded-2xl p-6 sm:p-8 mb-12">
        <h2 class="text-2xl font-bold text-zinc-900 mb-6">Plan Your Visit</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-white border border-zinc-200 rounded-xl p-5">
            <p class="text-xs font-semibold tracking-wide text-zinc-400 uppercase mb-1">Address</p>
            <p class="text-sm text-zinc-700">{spot.address}</p>
          </div>
          {spot.gettingThere && (
            <div class="bg-white border border-zinc-200 rounded-xl p-5">
              <p class="text-xs font-semibold tracking-wide text-zinc-400 uppercase mb-1">Getting There</p>
              <p class="text-sm text-zinc-700">{spot.gettingThere}</p>
            </div>
          )}
        </div>
      </div>

      <!-- Tips -->
      <h2 class="text-2xl font-bold text-zinc-900 mb-6">Visit Tips</h2>
      <ul class="space-y-3 mb-12">
        {spot.tips.map((tip) => (
          <li class="flex gap-3 text-zinc-700 text-sm leading-relaxed">
            <span class="flex-shrink-0 w-6 h-6 rounded-full bg-blue-100 text-blue-700 flex items-center justify-center mt-0.5"><Icon name="check" class="w-3.5 h-3.5" /></span>
            <span>{tip}</span>
          </li>
        ))}
      </ul>

      <!-- Other review sources not already linked up top -->
      {spot.reviewLinks.filter((r) => r.label !== "Google Maps" && r.label !== "Official site").length > 0 && (
        <Callout eyebrow={isAttraction ? "More Resources" : "More Reviews"} tone="neutral" class="mb-12">
          <p class="text-sm text-zinc-600 leading-relaxed mb-5">{isAttraction ? "Access, hours, and safety restrictions change often — tap through to see what's current before you go." : "Ratings change constantly, so we don't reproduce review content here — tap through to see what's current."}</p>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
            {spot.reviewLinks.filter((r) => r.label !== "Google Maps" && r.label !== "Official site").map((r) => (
              <a href={r.url} target="_blank" rel="noopener" class="group flex flex-col gap-1 bg-white border border-zinc-200 rounded-lg p-4 hover:border-accent-300 transition-colors no-underline">
                <span class="text-sm font-bold text-zinc-900 group-hover:text-accent-600 transition-colors">{r.label} ↗</span>
                <span class="text-xs text-zinc-500">{r.note}</span>
              </a>
            ))}
          </div>
        </Callout>
      )}

      <!-- Reservation CTA -->
      <div class="text-center mb-12">
        <p class="text-lg font-semibold text-zinc-900 mb-1">Ready to visit {spot.name}?</p>
        <p class="text-sm text-zinc-500 mb-5">{isAttraction ? "Check current conditions before you go." : "One phone call away."}</p>
        <p class="text-xl font-bold text-zinc-900 tabular-nums">{spot.phone}</p>
      </div>

      {spot.disclaimer && (
        <Callout eyebrow="A Note on This Guide" tone="amber" class="mb-12">
          <p class="text-sm text-zinc-600 leading-relaxed">{spot.disclaimer}</p>
        </Callout>
      )}

      <!-- FAQ -->
      <h2 class="text-2xl font-bold text-zinc-900 mb-6">FAQs</h2>
      <div class="space-y-3 mb-12">
        {spot.faqs.map((f) => (
          <details class="group border border-zinc-200 rounded-xl overflow-hidden">
            <summary class="list-none p-5 cursor-pointer flex items-center justify-between gap-4">
              <span class="text-sm font-semibold text-zinc-800">{f.q}</span>
              <svg class="w-5 h-5 text-zinc-300 flex-shrink-0 group-open:rotate-180 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="px-5 pb-5">
              <p class="text-sm text-zinc-600 leading-relaxed">{f.a}</p>
            </div>
          </details>
        ))}
      </div>

      <!-- Back to region -->
      {parentRegion && (
        <div class="mt-12 text-center">
          <a href={`/region/${parentRegion.slug}`} class="inline-flex items-center gap-1.5 text-sm font-medium text-accent-600 hover:text-accent-700 transition-colors">
            <Icon name="arrow-left" class="w-4 h-4" />
            Best time to visit {parentRegion.shortName}
          </a>
        </div>
      )}
    </div>
  </section>
  <Footer />
</BaseLayout>
