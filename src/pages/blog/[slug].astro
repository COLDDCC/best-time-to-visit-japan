---
import "../../styles/global.css";
import { pagePath } from "../../utils/urls";
import TravelVisualGuide from "../../components/TravelVisualGuide.astro";
import LiveForecast from "../../components/LiveForecast.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFormatter = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const wordCount = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(wordCount / 200));

const showForecast = post.data.tags.includes("weather") || post.data.tags.includes("packing");
const planningMonths = ["november", "december", "january"].filter(month => post.data.tags.includes(month));
const faqSchema = JSON.stringify({
  "@context": "https://schema.org", "@type": "FAQPage",
  mainEntity: post.data.faqs.map(faq => ({ "@type": "Question", name: faq.question,
    acceptedAnswer: { "@type": "Answer", text: faq.answer } })),
});
const articleSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  ...(post.data.updatedDate && { dateModified: post.data.updatedDate.toISOString() }),
  author: { "@type": "Organization", name: "When to Visit Japan" },
  mainEntityOfPage: new URL(pagePath(Astro.url.pathname), Astro.site).href,
  ...(post.data.image && { image: new URL(post.data.image, Astro.site).href }),
});
---

<BaseLayout title={post.data.seoTitle ?? post.data.title} description={post.data.description} ogImage={post.data.image}>
  <script type="application/ld+json" set:html={articleSchema} />
  {post.data.faqs.length > 0 && <script type="application/ld+json" set:html={faqSchema} />}
  <section class="min-h-[100dvh]">
    <Nav />
    <article class="max-w-3xl mx-auto px-4 py-6">
      <p class="text-sm font-medium tracking-wide text-accent-600 uppercase mb-4">Blog</p>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-zinc-900 mb-4 leading-tight break-words">{post.data.title}</h1>
      {post.data.quickAnswer && <p class="mb-4 text-base leading-relaxed text-zinc-700">{post.data.quickAnswer}</p>}
      {planningMonths.length > 0 && <nav aria-label="Plan by month" class="flex flex-wrap gap-2 mb-4">
        {planningMonths.map(month => <a href={`/month/${month}/`} class="rounded-full border border-accent-200 bg-accent-50 px-4 py-2 text-sm font-medium text-accent-700">{month[0].toUpperCase() + month.slice(1)} weather & trip guide →</a>)}
      </nav>}
      {planningMonths.some(m => m === "november" || m === "december") && <TravelVisualGuide month={planningMonths.includes("november") ? "november" : "december"} />}
      {post.data.image && (
        <img src={post.data.image} alt={post.data.imageAlt ?? post.data.title} width="1280" height="720" loading="eager" fetchpriority="high" decoding="async" class="post-hero" />
      )}

      <p class="text-sm text-zinc-600 mb-5">
        Published {dateFormatter.format(post.data.pubDate)} · {readingTime} min read
        {post.data.updatedDate && <> · Updated {dateFormatter.format(post.data.updatedDate)}</>}
      </p>

      {showForecast && <LiveForecast defaultCity={post.id.includes("snow") ? "sapporo" : "tokyo"} />}

      <div class="post-content text-zinc-700 leading-relaxed">
        <Content />
      </div>

      {post.data.faqs.length > 0 && <section class="mt-8" aria-label="Frequently asked questions">
        <h2 class="text-2xl font-bold mb-3">Quick questions</h2>
        {post.data.faqs.map(faq => <details class="border-b border-zinc-200 py-4"><summary class="cursor-pointer font-semibold">{faq.question}</summary><p class="mt-3 leading-relaxed text-zinc-700">{faq.answer}</p></details>)}
      </section>}
      {post.data.tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-12 pt-8 border-t border-zinc-200">
          {post.data.tags.map((tag) => (
            <span class="text-xs font-semibold tracking-wide uppercase text-zinc-700 bg-zinc-100 rounded-full px-3 py-1">{tag}</span>
          ))}
        </div>
      )}

      <a href="/blog/" class="inline-flex items-center gap-1.5 mt-10 text-sm font-medium text-accent-600 hover:text-accent-700 no-underline">← Back to all articles</a>
    </article>
  </section>
  <Footer />
</BaseLayout>

<script>
  // Markdown task lists are disabled by default. Make packing lists usable,
  // and retain progress on this device when local storage is available.
  const storageKey = `packing:${location.pathname}`;
  const boxes = Array.from(document.querySelectorAll<HTMLInputElement>('.post-content input[type="checkbox"]'));
  let saved: boolean[] = [];
  try { saved = JSON.parse(localStorage.getItem(storageKey) ?? '[]'); } catch {}
  boxes.forEach((box, index) => {
    box.disabled = false;
    box.setAttribute('aria-label', box.closest('li')?.textContent?.trim() || `Packing item ${index + 1}`);
    box.checked = Array.isArray(saved) && saved[index] === true;
    box.addEventListener('change', () => {
      try { localStorage.setItem(storageKey, JSON.stringify(boxes.map(item => item.checked))); } catch {}
    });
  });
</script>

<style>
  .post-hero { display: block; width: 100%; aspect-ratio: 16 / 9; height: auto; max-height: 360px; object-fit: cover; border-radius: 1rem; margin: 0 0 1rem; }

  .post-content :global(h2) {
    font-size: 1.5rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-zinc-900, #18181b);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }
  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }
  .post-content :global(ul),
  .post-content :global(ol) {
    margin: 0 0 1.25rem 1.25rem;
    list-style: disc;
  }
  .post-content :global(ol) {
    list-style: decimal;
  }
  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }
  .post-content :global(li > p) {
    margin-bottom: 0;
  }
  .post-content :global(strong) {
    color: var(--color-zinc-900, #18181b);
    font-weight: 600;
  }
  .post-content :global(a) {
    color: var(--color-accent-600, #dc2626);
    text-decoration: underline;
  }
</style>

<style>
  .post-content :global(table) { display: block; overflow-x: auto; -webkit-overflow-scrolling: touch; max-width: 100%; }
  .post-content :global(table) { width: 100%; border-collapse: collapse; margin: 1.5rem 0; font-size: .9rem; }
  .post-content :global(th), .post-content :global(td) { padding: .65rem; min-width: 6rem; border-bottom: 1px solid #d4d4d8; text-align: left; vertical-align: top; }
  .post-content :global(th) { background: #f0f7f7; color: #164e50; font-weight: 700; }
</style>

<style>
  .post-content :global(figure) { margin: 2rem 0; }
  .post-content :global(figure img) { width: 100%; height: auto; max-height: 340px; object-fit: cover; border-radius: 1rem; }
  .post-content :global(figcaption) { margin-top: .7rem; font-size: .85rem; color: #52525b; line-height: 1.6; }
  .post-content :global(tbody tr:nth-child(even)) { background: #fafafa; }
  .post-content :global(.rain-chart) { padding: 1.25rem; background: #f0f7f7; border: 1px solid #cfe3e3; border-radius: 1rem; }
  .post-content :global(.chart-title) { margin: 0 0 .25rem; font-size: 1.1rem; color: #164e50; font-weight: 700; }
  .post-content :global(.chart-subtitle) { font-size: .85rem; color: #52525b; margin: 0 0 1.25rem; }
  .post-content :global(.rain-row) { display: grid; grid-template-columns: 5.5rem minmax(0, 1fr) 4.5rem; align-items: center; gap: .75rem; margin: .9rem 0; font-size: .9rem; }
  .post-content :global(.rain-track) { height: .9rem; border-radius: 1rem; background: #dce9e9; overflow: hidden; }
  .post-content :global(.rain-bar) { display: block; height: 100%; background: #327a7d; border-radius: 1rem; }
  .post-content :global(.rain-value) { text-align: right; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .post-content :global(.rain-chart figcaption) { border-top: 1px solid #cfe3e3; padding-top: .75rem; }
  @media (max-width: 480px) {
    .post-content :global(.rain-chart) { padding: 1rem; }
    .post-content :global(.rain-row) { grid-template-columns: 4.25rem minmax(0, 1fr) 4rem; gap: .5rem; font-size: .8rem; }
    .post-content :global(th), .post-content :global(td) { padding: .6rem .5rem; font-size: .85rem; }
  }
</style>
