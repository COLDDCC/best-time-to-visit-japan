---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog")).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<BaseLayout title="Japan Travel & Culture Blog" description="Practical guides to Japanese travel etiquette and culture — onsen manners, dining customs, navigating trains, and more, for first-time visitors.">
  <section class="min-h-[100dvh]">
    <Nav />
    <div class="max-w-7xl mx-auto px-4 py-6">
      <p class="text-sm font-medium tracking-wide text-accent-600 uppercase mb-4">Blog</p>
      <h1 class="text-4xl md:text-5xl font-bold tracking-tighter text-zinc-900 mb-4 leading-none">Japan Travel & Culture</h1>
      <p class="text-lg text-zinc-500 max-w-2xl leading-relaxed mb-16">Practical guides to the etiquette and customs that don't fit in a packing list — written for first-time visitors.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="group bg-white border border-zinc-200 rounded-2xl overflow-hidden hover:border-accent-300 transition-colors no-underline flex flex-col">
            <div class="relative overflow-hidden bg-zinc-50">
              {post.data.image ? (
                <img src={post.data.image} alt={post.data.imageAlt ?? post.data.title} loading="lazy" decoding="async" class="w-full h-48 object-cover transition-transform duration-500 group-hover:scale-105" />
              ) : (
                <div class="w-full h-48 flex items-center justify-center">
                  <p class="text-xs text-zinc-400">Photo coming soon</p>
                </div>
              )}
            </div>
            <div class="p-6 flex flex-col flex-1">
              <p class="text-xs font-semibold tracking-widest uppercase text-accent-600 mb-1">{dateFormatter.format(post.data.pubDate)}</p>
              <h2 class="text-xl font-bold tracking-tight text-zinc-900 mb-2 group-hover:text-accent-600 transition-colors">{post.data.title}</h2>
              <p class="text-sm text-zinc-500 leading-relaxed">{post.data.description}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
  <Footer />
</BaseLayout>
