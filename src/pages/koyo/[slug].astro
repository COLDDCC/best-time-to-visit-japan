---
import "../../styles/global.css";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Callout from "../../components/Callout.astro";
import Icon from "../../components/Icon.astro";
import AffiliateCTA from "../../components/AffiliateCTA.astro";
import PeakChecker from "../../components/islands/PeakChecker.tsx";
import {
  publishedFoliageSpots,
  spotStats,
  bestWindow,
  jmaComparison,
  resolvedFaqs,
  formatOrdinal,
  formatMonthDay,
  formatFullDate,
  autumnOrdinal,
  type FoliageSpot,
} from "../../data/foliage.ts";

export function getStaticPaths() {
  // Only spots that are undrafted AND carry enough sourced years (enforced in the data module).
  return publishedFoliageSpots.map((spot) => ({
    params: { slug: spot.slug },
    props: { spot },
  }));
}

interface Props {
  spot: FoliageSpot;
}

const { spot } = Astro.props;
const canonical = `https://best-time-japan.com/koyo/${spot.slug}`;

// Every number on this page comes from these three; nothing below is hand-written.
const stats = spotStats(spot)!;
const best = bestWindow(spot)!;
const jma = jmaComparison(spot);
const faqs = resolvedFaqs(spot);

const records = spot.records.slice().sort((a, b) => b.year - a.year);
const timelineSpan = stats.timelineTo - stats.timelineFrom;
const pct = (ordinal: number) => ((ordinal - stats.timelineFrom) / timelineSpan) * 100;

// Tick marks on the 1st and 15th of each month the timeline actually covers.
const ticks: { ordinal: number; label: string }[] = [];
for (const month of [10, 11, 12]) {
  for (const day of [1, 15]) {
    const ordinal = autumnOrdinal(`${month}-${day}`);
    if (ordinal >= stats.timelineFrom && ordinal <= stats.timelineTo) {
      ticks.push({ ordinal, label: formatOrdinal(ordinal) });
    }
  }
}

const bestRange =
  best.fromOrdinal === best.toOrdinal
    ? formatOrdinal(best.fromOrdinal)
    : `${formatOrdinal(best.fromOrdinal)}–${formatOrdinal(best.toOrdinal)}`;

const attractionSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  "name": spot.name,
  "alternateName": spot.nameJa,
  "description": spot.meta,
  "url": canonical,
  "address": { "@type": "PostalAddress", "addressLocality": spot.city, "addressCountry": "JP" },
  ...(spot.image ? { "image": `https://best-time-japan.com${spot.image}` } : {}),
});

const faqSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map((f) => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
});
---

<BaseLayout
  title={`${spot.name} Autumn Leaves: Peak Dates by Year`}
  description={spot.meta}
  ogImage={spot.image}
>
  <script type="application/ld+json" set:html={attractionSchema} />
  <script type="application/ld+json" set:html={faqSchema} />

  <section class="min-h-[100dvh]">
    <Nav />
    <div class="max-w-4xl mx-auto px-4 py-8">
      <p class="text-xs font-semibold tracking-[0.2em] uppercase text-accent-600 mb-4">
        Kyoto Koyo · {spot.nameJa}
      </p>
      <h1 class="text-3xl md:text-5xl font-bold tracking-tighter text-zinc-900 mb-4 leading-[1.05]">
        When Do {spot.name}&rsquo;s Autumn Leaves Peak? (Past Peak Dates &amp; Your Odds)
      </h1>
      <p class="text-lg text-zinc-700 leading-relaxed mb-8">{spot.tagline} &mdash; {spot.city}</p>

      <!-- One-sentence answer, computed from the records -->
      <div class="bg-gradient-to-br from-amber-50 via-white to-red-50 border-2 border-amber-200 rounded-2xl p-6 sm:p-8 mb-10">
        <p class="text-xs font-semibold tracking-[0.2em] uppercase text-accent-600 mb-3">
          The short answer
        </p>
        <p class="text-xl sm:text-2xl font-bold text-zinc-900 leading-snug mb-4">
          {bestRange} fell inside peak colour in {best.hits} of the last {best.years} seasons at {spot.name}.
        </p>
        <p class="text-sm text-zinc-700 leading-relaxed">
          Across {stats.years} recorded seasons ({stats.firstYear}&ndash;{stats.lastYear}), peak
          started on {formatOrdinal(stats.meanStart)} on average and lasted about {stats.meanLength}
          days. The earliest peak on record began {formatOrdinal(stats.earliestStart)}; the latest
          ended {formatOrdinal(stats.latestEnd)}.
        </p>
      </div>

      <!-- Date checker -->
      <div class="mb-12">
        <PeakChecker spots={[spot]} client:visible />
      </div>

      <!-- Intro -->
      {spot.intro.map((p) => (
        <p class="text-zinc-600 leading-relaxed mb-6 text-base md:text-lg">{p}</p>
      ))}

      <!-- Year-by-year records -->
      <h2 class="text-2xl font-bold text-zinc-900 mt-12 mb-2">Observed peak windows, year by year</h2>
      <p class="text-sm text-zinc-700 mb-6">
        Each row is a reported 見頃 (peak viewing) window for that season, with the source it came
        from. Years without a reliable source are left out rather than estimated.
      </p>

      <div class="overflow-x-auto mb-8">
        <table class="w-full text-sm border-collapse">
          <thead>
            <tr class="border-b-2 border-zinc-200 text-left">
              <th class="py-3 pr-4 font-semibold text-zinc-900">Year</th>
              <th class="py-3 pr-4 font-semibold text-zinc-900">Peak began</th>
              <th class="py-3 pr-4 font-semibold text-zinc-900">Peak ended</th>
              <th class="py-3 font-semibold text-zinc-900">Source</th>
            </tr>
          </thead>
          <tbody>
            {records.map((r) => (
              <tr class="border-b border-zinc-100 align-top">
                <td class="py-3 pr-4 font-semibold text-zinc-900 tabular-nums">{r.year}</td>
                <td class="py-3 pr-4 text-zinc-700 tabular-nums whitespace-nowrap">{formatMonthDay(r.peakStart)}</td>
                <td class="py-3 pr-4 text-zinc-700 tabular-nums whitespace-nowrap">
                  {formatMonthDay(r.peakEnd)}
                  {r.note && <span class="block text-xs text-amber-700 mt-1 whitespace-normal">{r.note}</span>}
                </td>
                <td class="py-3">
                  <a
                    href={r.sourceUrl}
                    target="_blank"
                    rel="noopener"
                    class="text-accent-600 hover:text-accent-700 underline underline-offset-2"
                  >
                    {r.sourceLabel} &#8599;
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <!-- Timeline -->
      <div class="bg-zinc-50 border border-zinc-200 rounded-2xl p-5 sm:p-7 mb-12">
        <p class="text-sm font-bold text-zinc-900 mb-1">Early year or late year?</p>
        <p class="text-xs text-zinc-700 mb-6">
          Each bar is one season&rsquo;s peak window on the same scale, newest at the top.
        </p>

        <div class="space-y-2.5">
          {records.map((r) => (
            <div class="flex items-center gap-3">
              <span class="w-10 flex-shrink-0 text-xs font-semibold text-zinc-700 tabular-nums">{r.year}</span>
              <div class="relative flex-1 h-7 rounded-md bg-white border border-zinc-200 overflow-hidden">
                {ticks.map((t) => (
                  <span
                    class="absolute top-0 bottom-0 w-px bg-zinc-200"
                    style={`left:${pct(t.ordinal)}%`}
                    aria-hidden="true"
                  ></span>
                ))}
                <span
                  class="absolute top-1 bottom-1 rounded bg-gradient-to-r from-amber-400 to-red-500 min-w-[3px]"
                  style={`left:${pct(autumnOrdinal(r.peakStart))}%;width:${pct(autumnOrdinal(r.peakEnd)) - pct(autumnOrdinal(r.peakStart))}%`}
                ></span>
              </div>
              <span class="hidden sm:block w-[5.5rem] flex-shrink-0 text-[0.6875rem] text-zinc-600 tabular-nums text-right">
                {formatMonthDay(r.peakStart)}&ndash;{formatMonthDay(r.peakEnd)}
              </span>
            </div>
          ))}
        </div>

        <!-- Axis -->
        <div class="flex items-center gap-3 mt-2">
          <span class="w-10 flex-shrink-0"></span>
          <div class="relative flex-1 h-4">
            {ticks.map((t) => (
              <span
                class="absolute top-0 text-[0.625rem] text-zinc-500 -translate-x-1/2 whitespace-nowrap"
                style={`left:${pct(t.ordinal)}%`}
              >{t.label}</span>
            ))}
          </div>
          <span class="hidden sm:block w-[5.5rem] flex-shrink-0"></span>
        </div>
      </div>

      <!-- JMA baseline comparison -->
      {jma && (
        <Callout eyebrow="Against the city baseline" tone="neutral" class="mb-12">
          <p class="text-sm text-zinc-700 leading-relaxed">
            Over the {jma.overlapYears} seasons where both series overlap, {spot.name}&rsquo;s peak
            began
            {jma.meanOffsetDays === 0 ? (
              <span> on the same day as</span>
            ) : (
              <span>
                {" "}about {Math.abs(jma.meanOffsetDays)} day{Math.abs(jma.meanOffsetDays) === 1 ? "" : "s"}{" "}
                {jma.meanOffsetDays > 0 ? "after" : "before"}
              </span>
            )} the Japan Meteorological Agency&rsquo;s かえで紅葉日 for Kyoto &mdash; the date the
            observatory&rsquo;s own reference maple is judged to have turned. That baseline tracks a
            single tree at the observatory, not this garden, so it is useful for telling an early
            season from a late one and not much else.
          </p>
        </Callout>
      )}

      <!-- Viewing tips -->
      <h2 class="text-2xl font-bold text-zinc-900 mb-6">Getting the most out of the visit</h2>
      <div class="space-y-6 mb-12">
        {spot.viewingTips.map((t) => (
          <div class="border-t border-zinc-200 pt-6 first:border-t-0 first:pt-0">
            <p class="text-base font-bold text-zinc-900 mb-1.5">{t.title}</p>
            <p class="text-sm text-zinc-600 leading-relaxed">{t.body}</p>
          </div>
        ))}
      </div>

      <!-- Access & admission -->
      <div class="bg-zinc-50 rounded-2xl p-6 sm:p-8 mb-12">
        <h2 class="text-2xl font-bold text-zinc-900 mb-6">Plan your visit</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="bg-white border border-zinc-200 rounded-xl p-5">
            <p class="text-xs font-semibold tracking-wide text-zinc-600 uppercase mb-1">Getting there</p>
            <p class="text-sm text-zinc-700 leading-relaxed">{spot.access}</p>
          </div>
          {spot.admission && (
            <div class="bg-white border border-zinc-200 rounded-xl p-5">
              <p class="text-xs font-semibold tracking-wide text-zinc-600 uppercase mb-1">Admission</p>
              <p class="text-sm text-zinc-700 leading-relaxed">{spot.admission}</p>
            </div>
          )}
          {spot.crowdNote && (
            <div class="bg-white border border-zinc-200 rounded-xl p-5">
              <p class="text-xs font-semibold tracking-wide text-zinc-600 uppercase mb-1">Crowds</p>
              <p class="text-sm text-zinc-700 leading-relaxed">{spot.crowdNote}</p>
            </div>
          )}
        </div>
      </div>

      <!-- Booking CTA -->
      <div class="text-center mb-12">
        <p class="text-lg font-semibold text-zinc-900 mb-1">Travelling inside the peak window?</p>
        <p class="text-sm text-zinc-700 mb-5">
          Kyoto rooms go first for the dates in that table. Book well ahead.
        </p>
        <AffiliateCTA destination="Kyoto" className="justify-center" />
      </div>

      <!-- FAQ -->
      <h2 class="text-2xl font-bold text-zinc-900 mb-6">FAQs</h2>
      <div class="space-y-3 mb-12">
        {faqs.map((f) => (
          <details class="group border border-zinc-200 rounded-xl overflow-hidden">
            <summary class="list-none p-5 cursor-pointer flex items-center justify-between gap-4">
              <span class="text-sm font-semibold text-zinc-800">{f.q}</span>
              <svg class="w-5 h-5 text-zinc-300 flex-shrink-0 group-open:rotate-180 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
            </summary>
            <div class="px-5 pb-5">
              <p class="text-sm text-zinc-600 leading-relaxed">{f.a}</p>
            </div>
          </details>
        ))}
      </div>

      <!-- Methodology -->
      <Callout eyebrow="How this page is put together" tone="amber" class="mb-12">
        <div class="text-xs text-zinc-600 leading-relaxed space-y-3">
          <p>
            <strong class="text-zinc-800">What &ldquo;peak&rdquo; means here.</strong> Japanese
            foliage reporting uses 見頃 (<em>migoro</em>) &mdash; the window when a site is judged
            worth seeing, not a single perfect day. Different reporters draw that line slightly
            differently, so treat the edges of every window as soft.
          </p>
          <p>
            <strong class="text-zinc-800">Where the dates come from.</strong> Every row in the table
            links to the report it came from. We record observed in-season status, not the
            pre-season 見頃予想 forecasts published each September.
          </p>
          <p>
            <strong class="text-zinc-800">The sample is small.</strong> This page has{" "}
            {stats.years} season{stats.years === 1 ? "" : "s"} on record. That is enough to see a
            pattern and nowhere near enough to predict one. We deliberately show a count of years
            rather than a percentage, because a percentage implies a precision {stats.years} years
            of data cannot support.
          </p>
          <p>
            <strong class="text-zinc-800">It is not a forecast.</strong> A warm autumn can delay
            peak by a week or more. Before you travel, check live reports from{" "}
            <a href="https://weathernews.jp/koyo/" target="_blank" rel="noopener" class="text-accent-600 underline underline-offset-2">ウェザーニュース 紅葉情報 &#8599;</a>{" "}
            or{" "}
            <a href="https://tenki.jp/kouyou/" target="_blank" rel="noopener" class="text-accent-600 underline underline-offset-2">日本気象協会 tenki.jp &#8599;</a>,
            and confirm opening hours and any illumination dates with the temple itself.
          </p>
          <p>
            Last record in this table: {formatFullDate(records[0].peakStart)}.
          </p>
        </div>
      </Callout>

      <div class="mt-12 text-center">
        <a href="/koyo/kyoto" class="inline-flex items-center gap-1.5 text-sm font-medium text-accent-600 hover:text-accent-700 transition-colors">
          <Icon name="arrow-left" class="w-4 h-4" />
          Compare every Kyoto koyo spot
        </a>
      </div>
    </div>
  </section>
  <Footer />
</BaseLayout>
