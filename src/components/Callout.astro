---
interface Props {
  eyebrow?: string;
  tone?: "neutral" | "red" | "green" | "amber";
  class?: string;
}

const { eyebrow, tone = "neutral", class: className = "" } = Astro.props;
const dot = {
  neutral: "bg-zinc-400",
  red: "bg-accent-500",
  green: "bg-emerald-500",
  amber: "bg-amber-400",
}[tone];
const labelColor = {
  neutral: "text-zinc-500",
  red: "text-accent-600",
  green: "text-emerald-600",
  amber: "text-amber-600",
}[tone];
---

<div class={`rounded-xl border border-zinc-200 bg-white p-6 md:p-7 ${className}`}>
  {eyebrow && (
    <div class="flex items-center gap-3 mb-4">
      <span class={`h-px w-8 ${dot}`}></span>
      <p class={`text-[0.7rem] font-semibold tracking-[0.2em] uppercase ${labelColor}`}>{eyebrow}</p>
    </div>
  )}
  <div class="text-zinc-700"><slot /></div>
</div>