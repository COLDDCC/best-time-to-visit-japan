---
import { routeLocale } from "../i18n/routing";
const {lang}=routeLocale(Astro.url.pathname);
const isJa=lang==="ja";
const isZh=lang==="zh-CN";
const currentYear = new Date().getFullYear();
const footerLinks = isZh ? [{href:"/zh-cn/",label:"首页"},{href:"/zh-cn/monthly-guide/",label:"月份指南"},{href:"/zh-cn/by-region/",label:"地区指南"},{href:"/zh-cn/faq/",label:"常见问题"},{href:"/about/",label:"关于本站（英文）"},{href:"/contact/",label:"联系（英文）"}] : isJa ? [{href:"/ja/",label:"ホーム"},{href:"/ja/monthly-guide/",label:"月別ガイド"},{href:"/ja/by-region/",label:"地域別ガイド"},{href:"/ja/faq/",label:"よくある質問"},{href:"/about/",label:"運営方針（英語）"},{href:"/contact/",label:"お問い合わせ（英語）"}] : [
  { href: "/", label: "Home" },
  { href: "/when-to-go/", label: "Quiz" },
  { href: "/monthly-guide/", label: "Monthly Guide" },
  { href: "/by-region/", label: "By Region" },
  { href: "/destinations/", label: "Places" },
  { href: "/festivals/", label: "Festivals" },
  { href: "/crowd-calendar/", label: "Crowds" },
  { href: "/matcha-taste/", label: "Matcha" },
  { href: "/blog/", label: "Blog" },
  { href: "/faq/", label: "FAQ" },
  { href: "/travel-cost/", label: "Cost" },
  { href: "/about/", label: "About" },
  { href: "/contact/", label: "Contact" },
  { href: "/privacy/", label: "Privacy" },
];
---

<div class="bg-zinc-950 text-zinc-400">
  <div class="max-w-7xl mx-auto px-4 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm">
      <p class="font-semibold text-zinc-300">When to Visit Japan</p>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        {footerLinks.map((link) => (
          <a href={link.href} class="hover:text-zinc-300 transition-colors">{link.label}</a>
        ))}
      </div>
      <p class="text-zinc-600">&copy; {currentYear} {isZh ? "日本最佳旅行时间。文中时间为当地时间。" : isJa ? "日本旅行のベストシーズン。時刻は現地時間です。" : "When to Visit Japan. All times local."}</p>
    </div>
    <p class="mt-6 text-center text-xs text-zinc-600">{isZh ? "本站包含推广链接。" : isJa ? "当サイトはアフィリエイトリンクを含みます。" : "This site contains affiliate links."} <a href="/about/#editorial-policy" class="underline hover:text-zinc-400">{isZh ? "编辑方针（英文）" : isJa ? "運営方針（英語）" : "Editorial policy"}</a></p>
  </div>
</div>