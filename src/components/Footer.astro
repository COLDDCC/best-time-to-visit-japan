---
const currentYear = new Date().getFullYear();
const footerLinks = [
  { href: "/", label: "Home" },
  { href: "/when-to-go", label: "Quiz" },
  { href: "/monthly-guide", label: "Monthly Guide" },
  { href: "/by-region", label: "By Region" },
  { href: "/festivals", label: "Festivals" },
  { href: "/crowd-calendar", label: "Crowds" },
  { href: "/matcha-taste", label: "Matcha" },
  { href: "/faq", label: "FAQ" },
  { href: "/travel-cost", label: "Cost" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
  { href: "/privacy", label: "Privacy" },
];
---

<div class="bg-zinc-950 text-zinc-400">
  <div class="max-w-7xl mx-auto px-4 py-10">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm">
      <p class="font-semibold text-zinc-300">When to Visit Japan</p>
      <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2">
        {footerLinks.map((link) => (
          <a href={link.href} class="hover:text-zinc-300 transition-colors">{link.label}</a>
        ))}
      </div>
      <p class="text-zinc-600">&copy; {currentYear} When to Visit Japan. All times local.</p>
    </div>
    <p class="mt-6 text-center text-xs text-zinc-600">This site contains <a href="/about#editorial-policy" class="underline hover:text-zinc-400">affiliate links</a>.</p>
  </div>
</div>