---
import { hotelSearchUrl, flightSearchUrl } from "../config/affiliates.ts";

interface Props {
  hotelLabel?: string;
  hotelSublabel?: string;
  flightLabel?: string;
  flightSublabel?: string;
  destination?: string;
  className?: string;
}

const {
  hotelLabel = "Search Hotels",
  hotelSublabel = "Booking.com",
  flightLabel = "Check Flights",
  flightSublabel = "Skyscanner",
  destination,
  className = "",
} = Astro.props;
---

<div class={`flex flex-col sm:flex-row gap-3 ${className}`}>
  <a
    href={hotelSearchUrl(destination)}
    target="_blank"
    rel="nofollow sponsored noopener"
    class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-accent-600 hover:bg-accent-700 text-white font-semibold rounded-full transition-colors no-underline"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
    <span>{hotelLabel}</span>
    <span class="text-xs font-normal text-white/70">{hotelSublabel}</span>
  </a>
  <a
    href={flightSearchUrl(destination)}
    target="_blank"
    rel="nofollow sponsored noopener"
    class="inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-zinc-900 hover:bg-zinc-800 text-white font-semibold rounded-full transition-colors no-underline"
  >
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/></svg>
    <span>{flightLabel}</span>
    <span class="text-xs font-normal text-white/70">{flightSublabel}</span>
  </a>
</div>
