---
import { buildPackingPlan } from '../data/packing-plan';
export interface Props { month: 'november' | 'december'; }
const { month } = Astro.props;
const initial = buildPackingPlan({ days:7,laundry:true,cold:false,route:'city',month });
---
<section class="packing-planner" id="packing-planner" data-default-month={month} aria-labelledby="packing-planner-title">
  <p class="planner-eyebrow">From outfit to suitcase</p>
  <h3 id="packing-planner-title">How many should you actually bring?</h3>
  <p class="planner-intro">A starting list for one adult. Change your trip length, laundry plan and warmth preference.</p>
  <div class="planner-controls">
    <label>Trip length<select data-setting="days"><option value="7">7 days</option><option value="14">14 days</option></select></label>
    <label>Laundry<select data-setting="laundry"><option value="yes">One wash halfway</option><option value="no">No laundry</option></select></label>
    <label>How you feel the cold<select data-setting="cold"><option value="no">Standard warmth</option><option value="yes">I feel cold easily</option></select></label>
  </div>
  <p class="planner-summary" aria-live="polite">{initial.summary}</p>
  <p class="planner-assumption">Quantities include what you wear on travel day. Everyday tops assume two wears; underwear and socks change daily. This is an editable planning estimate, not a weather forecast.</p>
  <div class="planner-table-scroll" role="region" tabindex="0" aria-label="Your packing quantities"><table><caption>Your packing quantities</caption><thead><tr><th scope="col">Packed</th><th scope="col">Item</th><th scope="col">Quantity</th><th scope="col">Why</th></tr></thead><tbody data-quantity-rows>{initial.items.map(item=><tr><td><input type="checkbox" data-pack-id={item.id} aria-label={`Packed: ${item.label}`} /></td><th scope="row">{item.label}</th><td>{item.qty}</td><td>{item.why}</td></tr>)}</tbody></table></div>
  <div class="planner-actions"><button type="button" data-copy-list>Copy list</button><button type="button" data-download-list>Download .txt</button><span data-planner-status role="status"></span></div>
  <details class="decision-guide" open><summary>Do I really need it?</summary><div class="planner-table-scroll" role="region" tabindex="0" aria-label="What to bring or skip"><table><caption>Bring, consider or leave behind</caption><thead><tr><th scope="col">Item</th><th scope="col">Starting decision</th><th scope="col">How to decide</th></tr></thead><tbody data-decision-rows>{initial.decisions.map(row=><tr><th scope="row">{row.item}</th><td>{row.decision}</td><td>{row.reason}</td></tr>)}</tbody></table></div></details>
  <details class="quantity-reference"><summary>Compare 7-day and 14-day quantities</summary><div class="planner-table-scroll" role="region" tabindex="0" aria-label="Trip length quantity comparison"><table><caption>One adult · includes worn items</caption><thead><tr><th scope="col">Item</th><th scope="col">7d + wash</th><th scope="col">7d, no wash</th><th scope="col">14d + wash</th><th scope="col">14d, no wash</th></tr></thead><tbody>{['tops','trousers','underwear','socks'].map(id=><tr><th scope="row">{initial.items.find(item=>item.id===id)!.label}</th>{[{days:7,laundry:true},{days:7,laundry:false},{days:14,laundry:true},{days:14,laundry:false}].map(variant=><td>{buildPackingPlan({ ...variant, days:variant.days as 7|14, cold:false,route:'city',month }).items.find(item=>item.id===id)!.qty}</td>)}</tr>)}</tbody></table></div></details>
  <p class="planner-footer">Change or add items for your activities and local forecast. Check the accommodation’s laundry facilities before relying on a halfway wash. Packing progress stays on this device when browser storage is available.</p>
  <noscript><p>The table above is the 7-day city example with one wash halfway. Trip customization requires JavaScript; the outfit selector and comparison tables still work.</p></noscript>
</section>
<script>
  import { buildPackingPlan, type PackingOptions, type PackingRoute } from '../data/packing-plan';
  document.querySelectorAll<HTMLElement>('.packing-planner').forEach(root=>{
    const guide=root.closest<HTMLElement>('.travel-visual')!;
    const settings=Object.fromEntries(Array.from(root.querySelectorAll<HTMLSelectElement>('[data-setting]')).map(el=>[el.dataset.setting!,el]));
    const quantityRows=root.querySelector<HTMLElement>('[data-quantity-rows]')!;
    const decisionRows=root.querySelector<HTMLElement>('[data-decision-rows]')!;
    const summary=root.querySelector<HTMLElement>('.planner-summary')!;
    const status=root.querySelector<HTMLElement>('[data-planner-status]')!;
    const storageKey=`japan-packing-v1:${location.pathname}`;
    let checks:Record<string,boolean>={};
    try { const saved=JSON.parse(localStorage.getItem(storageKey)||'{}');
      checks=saved.checks&&typeof saved.checks==='object'?saved.checks:{};
      for(const [key,el]of Object.entries(settings))if(Array.from(el.options).some(o=>o.value===saved.settings?.[key]))el.value=saved.settings[key];
    }catch{}
    function options():PackingOptions{return {days:settings.days.value==='14'?14:7,laundry:settings.laundry.value==='yes',cold:settings.cold.value==='yes',route:(guide.querySelector<HTMLInputElement>('.route-choice:checked')?.value||'city') as PackingRoute,month:guide.querySelector<HTMLInputElement>('.month-choice:checked')?.value==='november'?'november':'december'};}
    const itemKey=(item:{id:string;label:string;qty:number})=>`${item.id}|${item.label}|${item.qty}`;
    function save(){try{localStorage.setItem(storageKey,JSON.stringify({checks,settings:Object.fromEntries(Object.entries(settings).map(([key,el])=>[key,el.value]))}));}catch{status.textContent='Browser storage unavailable; you can still download your list.';}}
    function cell(tag:string,value:string){const node=document.createElement(tag);node.textContent=value;if(tag==='th')node.setAttribute('scope','row');return node;}
    function render(){const plan=buildPackingPlan(options());summary.textContent=plan.summary;quantityRows.replaceChildren();decisionRows.replaceChildren();status.textContent='';
      plan.items.forEach(item=>{const row=document.createElement('tr'),checkCell=document.createElement('td'),check=document.createElement('input');check.type='checkbox';check.checked=checks[itemKey(item)]===true;check.setAttribute('aria-label',`Packed: ${item.label}`);check.addEventListener('change',()=>{checks[itemKey(item)]=check.checked;save();});checkCell.append(check);row.append(checkCell,cell('th',item.label),cell('td',String(item.qty)),cell('td',item.why));quantityRows.append(row);});
      plan.decisions.forEach(item=>{const row=document.createElement('tr');row.append(cell('th',item.item),cell('td',item.decision),cell('td',item.reason));decisionRows.append(row);});
    }
    function exportText(){const plan=buildPackingPlan(options());return `Japan packing list\n${plan.summary}\nQuantities include worn items. Tops: two wears; underwear/socks: daily.\n\n`+plan.items.map(item=>`${checks[itemKey(item)]?'[x]':'[ ]'} ${item.qty} × ${item.label} — ${item.why}`).join('\n')+`\n\nAdjust to the local forecast and your activities.\n${location.origin}${location.pathname}\n`;}
    Object.values(settings).forEach(el=>el.addEventListener('change',()=>{render();save();}));
    guide.querySelectorAll<HTMLInputElement>('.month-choice,.route-choice').forEach(el=>el.addEventListener('change',render));
    root.querySelector('[data-copy-list]')!.addEventListener('click',async()=>{try{await navigator.clipboard.writeText(exportText());status.textContent='Packing list copied.';}catch{status.textContent='Copy is unavailable. Use Download .txt instead.';}});
    root.querySelector('[data-download-list]')!.addEventListener('click',()=>{const url=URL.createObjectURL(new Blob([exportText()],{type:'text/plain;charset=utf-8'})),link=document.createElement('a');link.href=url;link.download=`japan-${options().month}-${options().route}-${options().days}-day-packing.txt`;link.click();setTimeout(()=>URL.revokeObjectURL(url),1000);status.textContent='Your text list is ready.';});
    render();
  });
</script>
<style>
.packing-planner{border-top:1px solid #dfe4df;margin-top:1.6rem;padding-top:1.5rem;color:#303b3a;min-width:0;}.planner-eyebrow{font-size:.6rem;text-transform:uppercase;letter-spacing:.12em;color:#7a7366;margin:0 0 .45rem;}.packing-planner h3{font-family:'Newsreader',Georgia,serif;font-size:1.6rem;font-weight:500;letter-spacing:-.02em;line-height:1.2;margin:0 0 .6rem;}.planner-intro,.planner-assumption,.planner-footer{font-size:.75rem;line-height:1.6;color:#697370;margin:0 0 1rem;}.planner-controls{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.65rem;margin:1rem 0;}.planner-controls label{font-size:.7rem;line-height:1.5;font-weight:600;min-width:0;}.planner-controls select{display:block;width:100%;font:inherit;font-weight:400;background:#fff;border:1px solid #cdd6cf;border-radius:.5rem;padding:.65rem .4rem;margin-top:.35rem;min-width:0;color:#303b3a;}.planner-summary{font-size:.75rem;font-weight:600;line-height:1.6;margin:.7rem 0;}.planner-assumption{font-size:.65rem;}.planner-table-scroll{overflow:auto;max-width:100%;margin:.7rem 0 1rem;}.packing-planner table{border-collapse:collapse;width:100%;min-width:470px;text-align:left;font-size:.72rem;line-height:1.5;}.packing-planner caption{text-align:left;font-size:.68rem;padding-bottom:.6rem;color:#697370;}.packing-planner th,.packing-planner td{padding:.65rem .45rem;border-bottom:1px solid #dfe4df;vertical-align:top;}.packing-planner thead th{font-size:.62rem;color:#697370;text-transform:uppercase;letter-spacing:.03em;}.packing-planner tbody th{font-weight:600;}.packing-planner input[type='checkbox']{accent-color:#42665d;width:1rem;height:1rem;cursor:pointer;}.planner-actions{display:flex;flex-wrap:wrap;align-items:center;gap:.6rem;margin:.8rem 0 1.4rem;}.planner-actions button{border:1px solid #aebfb2;border-radius:999px;background:#fff;color:#355c50;font:inherit;font-size:.72rem;font-weight:600;padding:.6rem 1rem;cursor:pointer;}.planner-actions button:hover{background:#e9efe8;}.planner-actions span{font-size:.68rem;color:#526f5d;}.decision-guide,.quantity-reference{border-top:1px solid #dfe4df;padding-top:1rem;margin-top:1rem;}.packing-planner summary{font-size:.8rem;font-weight:600;cursor:pointer;line-height:1.5;}.planner-footer{font-size:.65rem;margin:1rem 0 0;}select:focus-visible,button:focus-visible,input:focus-visible,summary:focus-visible,.planner-table-scroll:focus-visible{outline:2px solid #42665d;outline-offset:3px;}@media(max-width:480px){.planner-controls{grid-template-columns:1fr;gap:.6rem;}.planner-controls label{font-size:.75rem;}.packing-planner h3{font-size:1.4rem;}}
</style>
