---
import { lateYearCities, expectedWetDays } from '../data/late-year-weather';
import ClimateFootnote from './ClimateFootnote.astro';
interface Props { mode?: 'overview' | 'rain' | 'comparison' | 'station'; station?: string; }
const { mode = 'overview', station } = Astro.props;
const cities = station ? lateYearCities.filter(c => c.name === station) : lateYearCities;
---
<section class="climate-summary" aria-label="Station climate normals">
<h2>{station ? `${station} November weather` : mode === 'comparison' ? 'November vs December: station comparison' : mode === 'rain' ? 'November rainy days by city' : 'November city decisions'}</h2>
{mode === 'rain' && <figure aria-label="November precipitation by city"><figcaption>Monthly precipitation, with wet-day counts alongside. Bar length measures millimetres, not chance of rain.</figcaption>{cities.map(c => <div class="rain-comparison"><span>{c.name}</span><meter min="0" max={Math.max(...cities.map(c => c.november[2]))} value={c.november[2]} aria-label={`${c.name}: ${c.november[2]} mm`} /><span>{c.november[2]} mm · {c.rainDays.november} wet days · ≈ {expectedWetDays(c.rainDays.november,7,'november').toFixed(1)} / 7 days</span></div>)}</figure>}
<div class="scroll" tabindex="0" role="region" aria-label="Climate comparison table">
<table data-climate-table={mode}><caption>JMA 1991–2020 monthly station normals</caption>
<thead><tr><th scope="col">City / station</th>{mode !== 'rain' && <th scope="col">November high / low °C</th>}{mode !== 'overview' && <><th scope="col">November precipitation mm</th><th scope="col">November wet days ≥1 mm</th></>}<th scope="col">Wet days / 7-day trip</th>{mode === 'comparison' && <><th scope="col">December high / low °C</th><th scope="col">December wet days ≥1 mm</th></>}{mode === 'rain' && <th scope="col">October precipitation mm</th>}{mode === 'station' && <th scope="col">November sunshine hours</th>}</tr></thead>
<tbody>{cities.map(c => <tr data-climate-city={c.name} data-november-wet-days={c.rainDays.november}><th scope="row"><a href={c.source}>{c.name}</a></th>{mode !== 'rain' && <td>{c.november[0].toFixed(1)} / {c.november[1].toFixed(1)}</td>}{mode !== 'overview' && <><td><a href={c.source}>{c.november[2].toFixed(1)}</a></td><td><a href={c.rainSource}>{c.rainDays.november.toFixed(1)}</a></td></>}<td>≈ {expectedWetDays(c.rainDays.november,7,'november').toFixed(1)}</td>{mode === 'comparison' && <><td>{c.december[0].toFixed(1)} / {c.december[1].toFixed(1)}</td><td><a href={c.rainSource}>{c.rainDays.december.toFixed(1)}</a></td></>}{mode === 'rain' && <td><a href={c.source}>{c.octoberPrecipitation.toFixed(1)}</a></td>}{mode === 'station' && <td><a href={c.source}>{c.sunshineHours.november.toFixed(1)}</a></td>}</tr>)}</tbody></table></div>
<ClimateFootnote />
</section>
<style>.climate-summary{margin:2rem 0}h2{font-size:1.5rem;font-weight:700;margin-bottom:1rem}.scroll{overflow-x:auto}table{width:100%;border-collapse:collapse;text-align:left;font-size:.85rem}th,td{padding:.8rem;min-width:7rem;border-bottom:1px solid #dfe4df}thead{background:#edf1e8}caption{text-align:left;margin-bottom:.6rem;color:#586861}a{text-decoration:underline}.scroll:focus-visible{outline:2px solid #42665d}figure{padding:1rem;background:#edf1e8;border-radius:.6rem;margin:1rem 0}figcaption{font-size:.85rem;margin-bottom:1rem}.rain-comparison{display:grid;grid-template-columns:8rem 1fr;gap:.4rem 1rem;margin:.8rem 0;font-size:.85rem}.rain-comparison span:last-child{grid-column:2}meter{width:100%}@media(max-width:480px){.rain-comparison{grid-template-columns:6rem 1fr;gap:.3rem}.rain-comparison span:last-child{font-size:.75rem}}</style>
