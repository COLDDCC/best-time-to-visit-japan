---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from './Nav.astro';
import Footer from './Footer.astro';
import { monthlyData } from '../data/weather';
import { monthsZh, regionsZh } from '../i18n/zh-cn';
const { kind='home', slug='' } = Astro.props;
const month=monthsZh.find(m=>m.slug===slug);
const weather=monthlyData.find(m=>m.month===slug);
const region=regionsZh.find(r=>r.slug===slug);
const titles:Record<string,string>={home:'日本几月去最好？按玩法选择旅行时间',months:'日本12个月旅行对比：天气、穿衣与注意事项',regions:'日本各地区最佳旅行时间',faq:'日本旅行时间怎么选：常见问题'};
const heading=kind==='month' ? `${month!.name}日本旅行：天气、穿衣与推荐玩法` : kind==='region' ? `${region!.name}最佳旅行时间` : titles[kind];
const intro=kind==='month'?month!.summary:kind==='region'?region!.intro:kind==='months'?'一张表比较12个月，按目的地与想体验的活动选择出发时间。':kind==='regions'?'同一个月，北海道与冲绳的旅行条件也不同。先定目的地，再选合适的季节。':'城市观光优先考虑春秋，看雪选冬季，祭典和高原可选夏季。樱花与红叶的最佳时间随地区、海拔和当年天气变化。';
const hero=kind==='month'?weather!.image:kind==='region'?region!.image:'/images/region-fuji.webp';
const faqs=[
 ['第一次去日本，什么时候比较合适？','以城市步行为主，可以优先考虑春秋。赏樱、赏枫、看雪、海边玩水适合的时间不同，先确定地点和玩法，再比较日期。'],
 ['想避开拥挤，怎么选日期？','日本大型连休、盂兰盆节、年末年初，以及热门赏花赏枫期容易拥挤。可以比较平日与周末，把热门景点放在早晨，并按实际日期查询住宿。'],
 ['梅雨季还适合去日本吗？','可以去，但最好准备雨天替代方案。庭园与博物馆、美术馆搭配，比全程户外更灵活。梅雨的时间和影响因地区而异。'],
 ['表里的气温适用于哪里？','表中数值是东京的月度参考，不是全国平均，也不是出发当天的预报。北海道、山区和冲绳需要单独查询。'],
 ['11月和12月，哪个更适合？','以本州红叶和秋日散步为主，可考虑11月；灯光秀与冬日温泉，可考虑12月。想看雪则要查看具体地区、海拔和实际积雪。'],
 ['出发前去哪里查预报和警报？','出发前查看日本气象厅的预报与警报，并核对交通机构和景点的官方公告。'],
];
---
<BaseLayout title={`${heading} | When to Visit Japan`} description={intro} ogImage={hero}>
 <Nav />
 <div class="zh-guide max-w-7xl mx-auto px-4 py-6 md:py-10">
  <p class="text-sm text-accent-600 font-semibold mb-3">先选玩法，再选日本的季节</p>
  <h1 class="text-3xl md:text-5xl font-bold leading-snug tracking-tight max-w-4xl">{heading}</h1>
  <p class="mt-4 text-zinc-600 leading-relaxed max-w-3xl">{intro}</p>
  {kind==='month' && <p class="mt-3 p-3 rounded-xl bg-accent-50 text-sm"><strong>东京气温参考：{weather!.tempLow}〜{weather!.tempHigh}℃</strong><br/>穿衣：{month!.packing}</p>}
  <img src={hero} alt={kind==='month'?`${month!.name}的日本季节风景`:kind==='region'?`${region!.name}风景`:'富士山风景'} width="1200" height="420" loading="eager" fetchpriority="high" class="w-full h-48 md:h-72 object-cover rounded-2xl mt-5" />

  {kind==='home' && <>
   <section class="grid grid-cols-2 lg:grid-cols-4 gap-3 mt-5" aria-label="按玩法快速选择">
    {[
     ['城市观光','春季与秋季','/zh-cn/monthly-guide/'],['樱花与红叶','按地区查询最佳时间','/zh-cn/by-region/'],['雪景与温泉','冬季，积雪看具体地区','/zh-cn/region/hokkaido/'],['祭典与高原','夏季，注意防暑','/zh-cn/month/july/']
    ].map(([a,b,c])=><a href={c} class="p-4 bg-accent-50 border border-accent-100 rounded-xl"><strong class="block text-sm text-accent-700">{a}</strong><span class="block mt-1 font-semibold">{b}</span></a>)}
   </section>
   <div class="flex flex-wrap gap-3 mt-6"><a href="/zh-cn/monthly-guide/" class="zh-button">比较12个月 →</a><a href="/zh-cn/by-region/" class="zh-outline">按目的地选择 →</a></div>
  </>}

  {kind==='month' && <>
   <section class="mt-6 grid md:grid-cols-3 gap-4" aria-label="出行要点">
    <div class="zh-panel"><h2>推荐玩法</h2><p>{month!.best}</p></div>
    <div class="zh-panel"><h2>东京气温参考</h2><p>{weather!.tempLow}〜{weather!.tempHigh}℃</p><small>不是旅行当天的预报</small></div>
    <div class="zh-panel"><h2>怎么穿衣</h2><p>{month!.packing}</p></div>
   </section>
   <section class="zh-panel mt-5"><h2>安排行程要注意</h2><p>{month!.note}</p><p class="mt-2">东京月度数据中的参考降雨天数为{weather!.rainDays}天。{slug === 'november' ? '11月使用 JMA 1991–2020 平年值，日降水量至少 1 mm（包括融雪）；不是出行预报。' : '数值会随降雨定义和统计时段变化，不能换算为旅行当天的降雨概率。'}</p></section>
   <section class="mt-8"><h2 class="text-2xl font-bold mb-4">不同地区，要分别考虑什么</h2><div class="zh-table-wrap"><table><thead><tr><th>地区</th><th>确定行程前</th></tr></thead><tbody><tr><td><a href="/zh-cn/region/hokkaido/">北海道与北日本</a></td><td>查询城市与山区温差、积雪路况及交通信息。</td></tr><tr><td><a href="/zh-cn/region/tokyo/">东京与本州城市游</a></td><td>留意早晚温差、目的地人流与营业信息。</td></tr><tr><td><a href="/zh-cn/region/okinawa/">冲绳与南部海岛</a></td><td>不要套用本州气温，单独查询天气、风与海浪。</td></tr></tbody></table></div></section>
   <div class="flex flex-wrap gap-3 mt-6"><a href="/zh-cn/monthly-guide/" class="zh-button">比较其他月份 →</a><a href={`/month/${slug}/`} lang="en" class="zh-outline">查看更详细的英文版 ↗</a></div>
  </>}

  {['home','months'].includes(kind) && <section class="mt-10" aria-labelledby="month-table"><h2 id="month-table" class="text-2xl font-bold mb-2">一张表比较12个月</h2><p class="text-sm text-zinc-600 mb-4">气温和降雨天数为东京的月度参考，不是全国平均或天气预报。</p>
   <div class="zh-table-wrap"><table><thead><tr><th>月</th><th>推荐玩法</th><th>东京气温参考</th><th>参考降雨天数</th><th>注意事项</th></tr></thead><tbody>{monthsZh.map(m=>{const w=monthlyData.find(x=>x.month===m.slug)!; return <tr><th><a href={`/zh-cn/month/${m.slug}/`}>{m.name} →</a></th><td>{m.best}</td><td class="whitespace-nowrap">{w.tempLow}〜{w.tempHigh}℃</td><td>{w.rainDays}日</td><td>{m.note}</td></tr>})}</tbody></table></div>
  </section>}

  {['home','regions'].includes(kind) && <section class="mt-10"><h2 class="text-2xl font-bold mb-4">按目的地选择季节</h2><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-5">{regionsZh.map(r=><a href={`/zh-cn/region/${r.slug}/`} class="border border-zinc-200 rounded-2xl overflow-hidden hover:border-accent-500"><img src={r.image} alt={`${r.name}风景`} loading="lazy" width="600" height="300" class="w-full h-36 object-cover"/><div class="p-4"><h3 class="font-bold text-lg">{r.name} →</h3><p class="text-sm mt-1 text-zinc-600">{r.season}</p></div></a>)}</div></section>}

  {kind==='region' && <>
   <section class="zh-panel mt-6"><h2>什么时间比较合适</h2><p class="text-lg font-semibold">{region!.season}</p><ul class="list-disc pl-5 mt-3 space-y-2">{region!.tips.map(t=><li>{t}</li>)}</ul></section>
   <section class="mt-8"><h2 class="text-2xl font-bold mb-4">不同季节，先确认这些</h2><div class="zh-table-wrap"><table><thead><tr><th>季节</th><th>选择依据</th><th>查看月份</th></tr></thead><tbody><tr><th>春</th><td>花期、日本连休与早晚温差</td><td><a href="/zh-cn/month/april/">查看4月 →</a></td></tr><tr><th>夏</th><td>高温、降雨、祭典与室内休息点</td><td><a href="/zh-cn/month/july/">查看7月 →</a></td></tr><tr><th>秋</th><td>红叶海拔差、台风信息与日落</td><td><a href="/zh-cn/month/november/">查看11月 →</a></td></tr><tr><th>冬</th><td>积雪、路况、公共交通与年末营业</td><td><a href="/zh-cn/month/december/">查看12月 →</a></td></tr></tbody></table></div></section>
   <div class="flex flex-wrap gap-3 mt-6"><a href="/zh-cn/by-region/" class="zh-button">查看其他地区 →</a><a href={`/region/${slug}/`} lang="en" class="zh-outline">查看更详细的英文版 ↗</a></div>
  </>}

  {['home','faq'].includes(kind) && <section class="mt-10"><h2 class="text-2xl font-bold mb-4">关于出发时间的常见问题</h2>{faqs.slice(0,kind==='faq'?6:3).map(([q,a])=><details class="border-b border-zinc-200 py-4"><summary class="font-semibold cursor-pointer">{q}</summary><p class="mt-3 text-zinc-600 leading-relaxed max-w-3xl">{a}</p></details>)}{kind==='home' && <a href="/zh-cn/faq/" class="inline-block mt-4 text-accent-700 font-medium">查看全部常见问题 →</a>}</section>}
  <aside class="mt-10 p-5 bg-zinc-50 rounded-xl text-sm text-zinc-600 leading-relaxed"><strong>出发前再确认</strong><p>季节参考不等于旅行当天的预报。请查看<a href="https://www.jma.go.jp/bosai/forecast/" target="_blank" rel="noopener noreferrer" class="underline">日本气象厅天气预报</a>，以及交通机构与景点的官方公告。</p></aside>
 </div>
 <Footer />
</BaseLayout>
<style>
 .zh-guide{line-height:1.85}.zh-guide h1{font-size:clamp(1.625rem,4vw,2.75rem);line-height:1.35}.zh-guide h1,.zh-guide h2,.zh-guide h3{font-family:system-ui,"PingFang SC","Microsoft YaHei",sans-serif;line-height:1.5}.zh-panel{border:1px solid #e4e4e7;border-radius:16px;padding:20px}.zh-panel h2{font-size:1rem;font-weight:700;margin-bottom:8px}.zh-panel small{font-size:.75rem;color:#71717a}.zh-table-wrap{overflow-x:auto;border:1px solid #e4e4e7;border-radius:14px}.zh-table-wrap table{border-collapse:collapse;width:100%;font-size:14px;text-align:left;min-width:560px}.zh-table-wrap th,.zh-table-wrap td{padding:14px;border-bottom:1px solid #e4e4e7;vertical-align:top}.zh-table-wrap thead{background:#f4f4f5}.zh-table-wrap a{color:#b04430;font-weight:600}.zh-button,.zh-outline{padding:10px 18px;border-radius:999px;font-weight:600;font-size:14px;display:inline-block}.zh-button{background:#b04430;color:#fff}.zh-outline{border:1px solid #d4d4d8;color:#3f3f46}
</style>
