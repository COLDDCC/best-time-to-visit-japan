---
interface City {
  name: string;
  lat: number;
  lon: number;
}

const cities: City[] = [
  { name: "Tokyo", lat: 35.6762, lon: 139.6503 },
  { name: "Kyoto", lat: 35.0116, lon: 135.7681 },
  { name: "Sapporo", lat: 43.0618, lon: 141.3545 },
  { name: "Okinawa", lat: 26.2124, lon: 127.6809 },
];
---

<div class="mb-12 bg-white border border-zinc-200 rounded-2xl p-6" id="current-weather" data-cities={JSON.stringify(cities)}>
  <div class="flex items-center justify-between mb-4 gap-2">
    <h2 class="text-lg font-bold text-zinc-900">Right Now in Japan</h2>
    <span class="text-xs text-zinc-400 whitespace-nowrap" id="current-weather-updated"></span>
  </div>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-3" id="current-weather-grid">
    {cities.map((c) => (
      <div class="bg-zinc-50 rounded-xl p-4 text-center" data-city={c.name}>
        <p class="text-xs font-semibold text-zinc-500 uppercase tracking-wide mb-1">{c.name}</p>
        <p class="text-2xl font-bold text-zinc-300" data-temp>&hellip;</p>
        <p class="text-xs text-zinc-400" data-desc>Loading&hellip;</p>
      </div>
    ))}
  </div>
  <p class="text-xs text-zinc-400 mt-4">Live conditions from <a href="https://open-meteo.com/" target="_blank" rel="noopener" class="underline hover:text-zinc-600">Open-Meteo</a>. These are today's actuals &mdash; scroll down for this month's typical averages.</p>
</div>

<script>
  const WEATHER_CODES: Record<number, string> = {
    0: "Clear sky", 1: "Mainly clear", 2: "Partly cloudy", 3: "Overcast",
    45: "Fog", 48: "Rime fog",
    51: "Light drizzle", 53: "Drizzle", 55: "Dense drizzle",
    61: "Slight rain", 63: "Rain", 65: "Heavy rain",
    71: "Slight snow", 73: "Snow", 75: "Heavy snow",
    80: "Rain showers", 81: "Rain showers", 82: "Violent showers",
    95: "Thunderstorm", 96: "Thunderstorm w/ hail", 99: "Thunderstorm w/ hail",
  };

  function describe(code: number): string {
    return WEATHER_CODES[code] ?? "—";
  }

  async function loadWeather() {
    const container = document.getElementById("current-weather");
    if (!container) return;
    const cities = JSON.parse(container.dataset.cities || "[]") as { name: string; lat: number; lon: number }[];

    const results = await Promise.all(
      cities.map(async (city) => {
        const cell = container.querySelector(`[data-city="${city.name}"]`);
        if (!cell) return false;
        try {
          const url = `https://api.open-meteo.com/v1/forecast?latitude=${city.lat}&longitude=${city.lon}&current=temperature_2m,weather_code&timezone=Asia%2FTokyo`;
          const res = await fetch(url);
          if (!res.ok) throw new Error(String(res.status));
          const data = await res.json();
          const temp = Math.round(data.current.temperature_2m);
          const code = data.current.weather_code;
          const tempEl = cell.querySelector("[data-temp]");
          const descEl = cell.querySelector("[data-desc]");
          if (tempEl) {
            tempEl.textContent = `${temp}°C`;
            tempEl.classList.remove("text-zinc-300");
            tempEl.classList.add("text-zinc-800");
          }
          if (descEl) descEl.textContent = describe(code);
          return true;
        } catch {
          const descEl = cell.querySelector("[data-desc]");
          if (descEl) descEl.textContent = "Unavailable";
          return false;
        }
      })
    );

    const updated = document.getElementById("current-weather-updated");
    if (updated && results.some(Boolean)) {
      const time = new Date().toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Tokyo" });
      updated.textContent = `Updated ${time} JST`;
    }
  }

  loadWeather();
</script>
