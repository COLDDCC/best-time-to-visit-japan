---
// Live conditions + 7-day forecast from Open-Meteo, loaded in the browser.
// Static HTML stays usable (and crawlable) if the API is unreachable.
interface Props {
  defaultCity?: string;
}
const { defaultCity = "tokyo" } = Astro.props;

const cities = [
  { id: "tokyo", name: "Tokyo", lat: 35.6895, lon: 139.6917 },
  { id: "kyoto", name: "Kyoto", lat: 35.0116, lon: 135.7681 },
  { id: "osaka", name: "Osaka", lat: 34.6937, lon: 135.5023 },
  { id: "sapporo", name: "Sapporo", lat: 43.0618, lon: 141.3545 },
  { id: "naha", name: "Okinawa (Naha)", lat: 26.2124, lon: 127.6809 },
];
const initial = cities.some((c) => c.id === defaultCity) ? defaultCity : "tokyo";
---

<section class="live-forecast my-8 rounded-2xl border border-zinc-200 bg-white p-5 md:p-6" aria-labelledby="live-forecast-title" data-cities={JSON.stringify(cities)} data-initial={initial}>
  <div class="flex flex-wrap items-baseline justify-between gap-2 mb-1">
    <h2 id="live-forecast-title" class="text-xl font-bold text-zinc-900 m-0">Live Japan weather: next 7 days</h2>
    <span class="text-xs text-zinc-600" data-updated></span>
  </div>
  <p class="text-sm text-zinc-600 mb-4">Travelling soon? Check the actual forecast here, alongside the long-term averages below.</p>

  <div class="flex gap-2 overflow-x-auto pb-1 mb-4" role="tablist" aria-label="Choose a city">
    {cities.map((c) => (
      <button type="button" role="tab" data-city-tab={c.id} aria-selected={c.id === initial ? "true" : "false"} class="lf-tab shrink-0 rounded-full border px-4 py-2 text-sm font-medium">{c.name}</button>
    ))}
  </div>

  <div class="flex flex-wrap items-center gap-x-6 gap-y-1 mb-4" data-now>
    <p class="text-3xl font-bold text-zinc-300 m-0" data-now-temp>…</p>
    <p class="text-sm text-zinc-700 m-0" data-now-desc>Loading forecast…</p>
  </div>

  <div class="overflow-x-auto" tabindex="0" aria-label="7-day forecast">
    <ol class="lf-days grid grid-cols-7 gap-2 min-w-[560px] list-none m-0 p-0" data-days></ol>
  </div>

  <p class="text-xs text-zinc-600 mt-4 mb-0">Forecast data: <a href="https://open-meteo.com/" target="_blank" rel="noopener" class="underline">Open-Meteo</a>. For official warnings and the latest update, check the <a href="https://www.jma.go.jp/bosai/forecast/" target="_blank" rel="noopener" class="underline">Japan Meteorological Agency forecast</a>.</p>
</section>

<style>
  .lf-tab { border-color: #d4d4d8; color: #3f3f46; background: #fff; }
  .lf-tab[aria-selected="true"] { border-color: var(--color-accent-600, #dc2626); background: var(--color-accent-600, #dc2626); color: #fff; }
  .live-forecast :global(.lf-day) { border-radius: 0.75rem; background: #fafafa; padding: 0.75rem 0.4rem; text-align: center; margin: 0; }
  .live-forecast :global(.lf-rainbar) { height: 4px; border-radius: 999px; background: #e4e4e7; overflow: hidden; margin: 0.4rem 0.4rem 0.2rem; }
  .live-forecast :global(.lf-rainbar > span) { display: block; height: 100%; background: #3b82f6; }
</style>

<script>
  const CODES: Record<number, string> = {
    0: "Clear", 1: "Mostly clear", 2: "Partly cloudy", 3: "Cloudy",
    45: "Fog", 48: "Fog",
    51: "Drizzle", 53: "Drizzle", 55: "Drizzle", 56: "Freezing drizzle", 57: "Freezing drizzle",
    61: "Light rain", 63: "Rain", 65: "Heavy rain", 66: "Freezing rain", 67: "Freezing rain",
    71: "Light snow", 73: "Snow", 75: "Heavy snow", 77: "Snow grains",
    80: "Showers", 81: "Showers", 82: "Heavy showers", 85: "Snow showers", 86: "Snow showers",
    95: "Thunderstorm", 96: "Thunderstorm", 99: "Thunderstorm",
  };
  const label = (code: number) => CODES[code] ?? "—";

  type City = { id: string; name: string; lat: number; lon: number };

  for (const root of document.querySelectorAll<HTMLElement>(".live-forecast")) {
    const cities = JSON.parse(root.dataset.cities || "[]") as City[];
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>("[data-city-tab]"));
    const nowTemp = root.querySelector<HTMLElement>("[data-now-temp]")!;
    const nowDesc = root.querySelector<HTMLElement>("[data-now-desc]")!;
    const daysEl = root.querySelector<HTMLElement>("[data-days]")!;
    const updated = root.querySelector<HTMLElement>("[data-updated]")!;
    const cache = new Map<string, any>();
    let active = "";

    const render = (city: City, data: any) => {
      const c = data.current;
      nowTemp.textContent = `${Math.round(c.temperature_2m)}°C`;
      nowTemp.classList.replace("text-zinc-300", "text-zinc-900");
      nowDesc.textContent = `Now in ${city.name}: ${label(c.weather_code)} · feels like ${Math.round(c.apparent_temperature)}°C`;
      const d = data.daily;
      daysEl.replaceChildren(...d.time.map((day: string, i: number) => {
        const date = new Date(`${day}T12:00:00+09:00`);
        const weekday = i === 0 ? "Today" : date.toLocaleDateString("en-US", { weekday: "short", timeZone: "Asia/Tokyo" });
        const md = date.toLocaleDateString("en-US", { month: "short", day: "numeric", timeZone: "Asia/Tokyo" });
        const rain = Math.round(d.precipitation_probability_max[i] ?? 0);
        const li = document.createElement("li");
        li.className = "lf-day";
        li.innerHTML = `
          <p class="text-xs font-semibold text-zinc-900 m-0">${weekday}</p>
          <p class="text-[11px] text-zinc-500 m-0">${md}</p>
          <p class="text-xs text-zinc-700 mt-2 mb-1 leading-tight min-h-[2rem]">${label(d.weather_code[i])}</p>
          <p class="text-sm font-bold text-zinc-900 m-0">${Math.round(d.temperature_2m_max[i])}°</p>
          <p class="text-xs text-zinc-500 m-0">${Math.round(d.temperature_2m_min[i])}°</p>
          <div class="lf-rainbar" aria-hidden="true"><span style="width:${rain}%"></span></div>
          <p class="text-[11px] text-blue-700 m-0" title="Chance of rain">☂ ${rain}%</p>`;
        return li;
      }));
      const t = new Date().toLocaleTimeString("en-US", { hour: "2-digit", minute: "2-digit", timeZone: "Asia/Tokyo" });
      updated.textContent = `Updated ${t} JST`;
    };

    const load = async (id: string) => {
      const city = cities.find((c) => c.id === id);
      if (!city) return;
      active = id;
      tabs.forEach((t) => t.setAttribute("aria-selected", String(t.dataset.cityTab === id)));
      try {
        let data = cache.get(id);
        if (!data) {
          const url = `https://api.open-meteo.com/v1/forecast?latitude=${city.lat}&longitude=${city.lon}&current=temperature_2m,apparent_temperature,weather_code&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max&timezone=Asia%2FTokyo&forecast_days=7`;
          const res = await fetch(url);
          if (!res.ok) throw new Error(String(res.status));
          data = await res.json();
          cache.set(id, data);
        }
        if (active === id) render(city, data);
      } catch {
        if (active !== id) return;
        nowTemp.textContent = "—";
        nowDesc.textContent = "Live forecast unavailable right now. Check the JMA forecast link below.";
        daysEl.replaceChildren();
      }
    };

    tabs.forEach((t) => t.addEventListener("click", () => load(t.dataset.cityTab!)));
    // Load only when the widget scrolls near the viewport.
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); load(root.dataset.initial || "tokyo"); }
    }, { rootMargin: "400px" });
    io.observe(root);
  }
</script>
