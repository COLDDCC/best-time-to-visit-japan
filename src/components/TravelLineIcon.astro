---
import jacket from '../assets/travel-icons/jacket.svg?raw';
import shirt from '../assets/travel-icons/shirt.svg?raw';
import shoe from '../assets/travel-icons/shoe.svg?raw';
import umbrella from '../assets/travel-icons/umbrella.svg?raw';
import sun from '../assets/travel-icons/sun.svg?raw';
import cloudRain from '../assets/travel-icons/cloud-rain.svg?raw';
import snowflake from '../assets/travel-icons/snowflake.svg?raw';
import wind from '../assets/travel-icons/wind.svg?raw';
// Clothing-specific SVG drawings complement the upstream symbol set.
const outline = (paths: string) => `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35" stroke-linecap="round" stroke-linejoin="round">${paths}</svg>`;
const longSleeves = outline('<path d="m9 4-4 2-3 8 4 1 2-5v10h8V10l2 5 4-1-3-8-4-2"/><path d="M9 4a3 3 0 0 0 6 0M8 17h8M3 12l4 1m10 0 4-1"/>');
const coat = outline('<path d="m8 3-4 3-2 9 4 1 2-6v11h8V10l2 6 4-1-2-9-4-3"/><path d="m8 3 4 4 4-4M12 7v14M8 15h2m4 0h2M3 13l4 1m10 0 4-1"/>');
const winterBoot = outline('<path d="M5 3h8v10l5 1a4 4 0 0 1 3 4v3H3v-4l2-3V3Z"/><path d="M5 6h8M3 18h18M10 9h3m-3 3h3m-2 3h3"/>');
const icons = { jacket, shirt, shoe, umbrella, sun, 'cloud-rain': cloudRain, snowflake, wind, 'long-sleeves': longSleeves, coat, 'winter-boot': winterBoot };
export interface Props { name: keyof typeof icons; }
const { name } = Astro.props;
// Source: tabler/tabler-icons, MIT. Full license is retained beside the SVGs.
---
<span class="line-icon" aria-hidden="true" set:html={icons[name]} />
<style>
.line-icon { display: inline-flex; width: 100%; height: 100%; }
.line-icon :global(svg) { width: 100%; height: 100%; stroke-width: 1.35; }
</style>
