---
import TravelLineIcon from './TravelLineIcon.astro';
import { lateYearCities, climateSource } from '../data/late-year-weather';
export interface Props { month?: 'november' | 'december'; }
const { month = 'november' } = Astro.props;
const key = `outfit-${month}`;
const months = ['november', 'december'] as const;
const routes = [
  { id:'city', label:'Tokyo & Osaka', station:'Tokyo', photo:'/images/region-tokyo.webp', alt:'Tokyo skyline with Mount Fuji in the distance', region:'tokyo', tone:'Cool city days',
    november:['Long sleeves + sweater','Removable jacket','Walking shoes with grip','Compact umbrella'],
    december:['Base layer + sweater','Warm outer coat','Closed walking shoes','Compact umbrella'],
    note:'Osaka has its own readings in the table. Check Kyoto separately. Add warmth for evenings outdoors.' },
  { id:'north', label:'Hokkaido', station:'Sapporo', photo:'/images/region-hokkaido.webp', alt:'Sapporo city lights at dusk', region:'hokkaido', tone:'Colder northern routes',
    november:['Warm base + mid-layer','Warmer coat','Footwear for the forecast','Rain / snow protection'],
    december:['Insulating base + mid-layer','Insulated winter coat','Winter-suitable footwear','Snow / wind protection'],
    note:'Snow and ice change footwear needs. Add gloves and a hat; check local conditions before leaving.' },
  { id:'south', label:'Okinawa', station:'Naha (Okinawa)', photo:'/images/region-okinawa.webp', alt:'The red main hall of Shuri Castle in Okinawa', region:'okinawa', tone:'Milder southern islands',
    november:['Light, breathable tops','Light outer layer','Comfortable walking shoes','Compact umbrella'],
    december:['Light, removable layers','Jacket for wind / evenings','Comfortable walking shoes','Compact umbrella'],
    note:'Naha is one station, not every island. Check wind and marine conditions separately for sea activities.' },
] as const;
const icons = ['shirt','jacket','shoe','umbrella'] as const;
---
<section class="travel-visual" id="visual-packing-guide" aria-labelledby={`${key}-title`}>
  <div class="visual-heading"><p class="eyebrow">A little less reading. A clearer suitcase.</p><h2 id={`${key}-title`}>Your weather-to-outfit guide</h2><p>Choose a month and a route. See what changes in your suitcase.</p></div>
  <fieldset class="month-options"><legend class="visually-hidden">Travel month</legend>{months.map(m=><label><input class="month-choice" type="radio" name={`${key}-month`} value={m} checked={m===month} /><span>{m==='november'?'November':'December'}</span></label>)}</fieldset>
  <fieldset class="route-options"><legend>Where are you going?</legend><div class="route-grid">{routes.map((r,i)=><label class="route-card"><img src={r.photo} alt={r.alt} width="420" height="220" loading="lazy" decoding="async" /><span class="route-label"><input class="route-choice" type="radio" name={`${key}-route`} value={r.id} checked={i===0} /><span>{r.label}</span></span></label>)}</div></fieldset>
  <div class="outfit-panels">{months.flatMap(m=>routes.map(r=>{
    const values=lateYearCities.find(c=>c.name===r.station)![m];
    return <div class="route-panel" data-month={m} data-route={r.id}>
      <div class="climate-note"><div class="weather-symbol"><TravelLineIcon name={r.id==='north'?'snowflake':r.id==='south'?'sun':'wind'} /></div><div><p class="route-tone">{r.tone}</p><h3>{r.label} <span>in {m==='november'?'November':'December'}</span></h3><p class="temperature">{values[0].toFixed(1)}° <span>/ {values[1].toFixed(1)}°C</span></p><p class="micro">{r.station} · average daily high / low</p></div></div>
      <ol class="outfit-items">{r[m].map((item,i)=><li><span class="item-number">0{i+1}</span><span class="garment"><TravelLineIcon name={i === 0 && r.id !== 'south' ? 'long-sleeves' : i === 1 ? 'coat' : i === 2 && r.id === 'north' && m === 'december' ? 'winter-boot' : i === 3 && r.id === 'north' ? 'snowflake' : icons[i]} /></span><span class="item-label">{item}</span></li>)}</ol>
      <p class="route-advice">{r.note}</p><a class="route-link" href={`/region/${r.region}/`}>Explore {r.label} →</a>
    </div>;
  }))}</div>
  <details class="climate-table"><summary>Compare all city temperatures & packing needs <span aria-hidden="true">＋</span></summary><div class="table-scroll" tabindex="0" role="region" aria-label="City climate comparison"><table><caption>November vs December · JMA station averages, °C</caption><thead><tr><th scope="col">City / station</th><th scope="col">Nov high / low</th><th scope="col">Dec high / low</th><th scope="col">Packing priority</th></tr></thead><tbody>{lateYearCities.map(c=><tr><th scope="row">{c.name}</th><td>{c.november[0]} / {c.november[1]}</td><td>{c.december[0]} / {c.december[1]}</td><td>{c.name==='Sapporo'?'Warmth + footwear for snow / ice':c.name.startsWith('Naha')?'Lighter layers + wind / rain cover':c.name==='Niigata'?'Rain / snow protection + warm layers':'Removable layers + walking comfort'}</td></tr>)}</tbody></table></div></details>
  <p class="source-note">Climate: <a href={climateSource}>JMA 1991–2020 normals</a>, not a forecast. Photos show destinations, not conditions on your dates. The line drawings are packing symbols; choose clothing for the local forecast.</p>
</section>
<style>
.travel-visual{--ink:#303b3a;--muted:#697370;--line:#dfE4df;--paper:#f7f8f4;color:var(--ink);border:1px solid var(--line);border-radius:1.25rem;padding:clamp(1rem,3vw,1.75rem);margin:1.5rem 0 2rem;background:linear-gradient(145deg,#fcfcf8,#f5f7f3);min-width:0;}
.visual-heading .eyebrow{font-size:.65rem;font-weight:600;text-transform:uppercase;letter-spacing:.12em;color:#7a7366;margin:0 0 .5rem;}.visual-heading h2{font-family:'Newsreader',Georgia,serif;font-size:clamp(1.6rem,4vw,2rem);font-weight:500;line-height:1.15;margin:0 0 .5rem;letter-spacing:-.025em;}.visual-heading>p:last-child{font-size:.85rem;color:var(--muted);margin:0 0 1rem;line-height:1.6;}
fieldset{border:0;padding:0;margin:0;min-width:0;}legend{font-size:.75rem;font-weight:600;margin-bottom:.65rem;}input{accent-color:#42665d;cursor:pointer;flex-shrink:0;}label{cursor:pointer;}.month-options{display:flex;gap:.35rem;padding:.25rem;background:#e9ede7;border-radius:999px;width:fit-content;margin:0 0 1.2rem;}.month-options label{display:flex;align-items:center;gap:.4rem;padding:.5rem .8rem;border-radius:999px;font-size:.78rem;}.month-options label:has(:checked){background:#fff;box-shadow:0 1px 3px #25372a12;}.month-options input{width:.75rem;height:.75rem;margin:0;}.route-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.6rem;}.route-card{border:1px solid var(--line);border-radius:.8rem;overflow:hidden;background:white;transition:border-color .15s;min-width:0;}.route-card:has(:checked){border-color:#42665d;box-shadow:0 0 0 1px #42665d;}.route-card img{width:100%;height:auto;aspect-ratio:1.8;object-fit:cover;display:block;}.route-label{display:flex;gap:.4rem;align-items:center;padding:.7rem .5rem;font-size:.78rem;font-weight:600;line-height:1.3;}.route-label input{margin:0;width:.8rem;height:.8rem;}.route-panel{display:none;padding-top:1.5rem;}.climate-note{display:flex;gap:1rem;align-items:center;padding-bottom:1.3rem;border-bottom:1px solid var(--line);}.weather-symbol{width:3.5rem;height:3.5rem;color:#9b8e68;flex-shrink:0;}.route-tone{text-transform:uppercase;letter-spacing:.1em;font-size:.6rem;color:var(--muted);margin:0 0 .3rem;}.climate-note h3{font-size:1rem;font-weight:600;margin:0 0 .4rem;}.climate-note h3 span{font-weight:400;color:var(--muted);}.temperature{font-family:'Newsreader',Georgia,serif;font-size:2rem;line-height:1;margin:0 0 .4rem;}.temperature span{color:#7d8782;}.micro{font-size:.66rem;margin:0;color:var(--muted);}.outfit-items{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:.5rem;list-style:none;padding:0;margin:1.25rem 0;}.outfit-items li{display:flex;flex-direction:column;align-items:center;text-align:center;position:relative;gap:.75rem;padding:.9rem .3rem .3rem;min-width:0;}.item-number{font-size:.58rem;color:#8c948e;align-self:flex-start;letter-spacing:.1em;}.garment{width:clamp(2.8rem,6vw,4.3rem);height:clamp(2.8rem,6vw,4.3rem);color:#44594f;}.item-label{font-size:.72rem;line-height:1.5;max-width:8rem;}.route-advice{font-size:.78rem;line-height:1.6;color:var(--muted);margin:.25rem 0 .65rem;}.route-link{font-size:.75rem;color:#355c50;text-decoration:underline;text-underline-offset:3px;}.climate-table{border-top:1px solid var(--line);margin-top:1.4rem;padding-top:1rem;}.climate-table summary{font-size:.78rem;font-weight:600;cursor:pointer;display:flex;justify-content:space-between;gap:1rem;line-height:1.5;}.climate-table summary span{font-size:1rem;color:#69776c;}.table-scroll{overflow:auto;margin-top:.9rem;}table{width:100%;border-collapse:collapse;font-size:.72rem;text-align:left;min-width:490px;}caption{text-align:left;font-size:.65rem;color:var(--muted);padding-bottom:.6rem;}th,td{border-bottom:1px solid var(--line);padding:.65rem .5rem;vertical-align:top;}thead th{color:#5c695f;font-size:.65rem;text-transform:uppercase;letter-spacing:.04em;}tbody th{font-weight:600;}tbody tr:last-child>*{border:0;}.source-note{font-size:.65rem;color:var(--muted);line-height:1.6;margin:1rem 0 0;}.source-note a{text-decoration:underline;}label:focus-within{outline:2px solid #42665d;outline-offset:3px;}.table-scroll:focus-visible,summary:focus-visible{outline:2px solid #42665d;outline-offset:3px;}.visually-hidden{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;}
.travel-visual:has(.month-choice[value="november"]:checked):has(.route-choice[value="city"]:checked) [data-month="november"][data-route="city"],.travel-visual:has(.month-choice[value="november"]:checked):has(.route-choice[value="north"]:checked) [data-month="november"][data-route="north"],.travel-visual:has(.month-choice[value="november"]:checked):has(.route-choice[value="south"]:checked) [data-month="november"][data-route="south"],.travel-visual:has(.month-choice[value="december"]:checked):has(.route-choice[value="city"]:checked) [data-month="december"][data-route="city"],.travel-visual:has(.month-choice[value="december"]:checked):has(.route-choice[value="north"]:checked) [data-month="december"][data-route="north"],.travel-visual:has(.month-choice[value="december"]:checked):has(.route-choice[value="south"]:checked) [data-month="december"][data-route="south"]{display:block;}
@supports not selector(:has(*)){.route-panel{display:block;}.month-options,.route-options input{display:none;}}
@media(max-width:480px){.route-label{font-size:.68rem;gap:.25rem;padding:.6rem .35rem;}.route-grid{gap:.4rem;}.route-label input{width:.7rem;height:.7rem;}.outfit-items{grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem 1rem;}.outfit-items li{padding:.4rem .5rem;}.garment{width:3.6rem;height:3.6rem;}.item-label{font-size:.75rem;}.visual-heading .eyebrow{font-size:.58rem;}.climate-note{gap:.7rem;}}
</style>
